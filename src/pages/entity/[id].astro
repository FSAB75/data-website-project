---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entities, works, getEntity, getWork, typeLabels, docTypeLabel, seriesOfEntity, entitiesOfSeries, workCover, scenePath, clip, DEFAULT_IMAGE_SOURCE } from '../../lib/data.js';
import { buildEntityIndex, linkify } from '../../lib/linkify.js';

export function getStaticPaths() {
  return entities.map((e) => ({ params: { id: e.id }, props: { entity: e } }));
}

const { entity } = Astro.props;
// 词条索引按系列隔离
const pack = seriesOfEntity(entity.id);
const index = buildEntityIndex(entitiesOfSeries(pack.id));
const theme = pack.series.theme;

const docToWork = new Map();
for (const w of works) {
  for (const d of w.documents || []) docToWork.set(d.id, w.id);
}

const factKeys = Object.keys(entity.facts || {});
const relations = (entity.relations || []).map((r: any) => ({ ...r, entity: getEntity(r.target) })).filter((r: any) => r.entity);
const relatedDocs = (entity.relatedDocs || []).map((docId: string) => {
  const workId = docToWork.get(docId);
  if (!workId) return null;
  const w = getWork(workId);
  const doc = (w?.documents || []).find((d: any) => d.id === docId);
  return doc ? { doc, work: w } : null;
}).filter(Boolean);
const appearedWorks = (entity.works || []).map(getWork).filter(Boolean);

// C6：没有 relations、也没有 relatedDocs 的词条（组织 / 地点 / 物品类居多）读完就无路可走。
// 这里做自动兜底：优先同类型 + 有共同登场作品的同系列词条，凑不满也不硬凑。
const isOrphan = relations.length === 0 && relatedDocs.length === 0;
const suggestions = isOrphan
  ? entitiesOfSeries(pack.id)
      .filter((e: any) => e.id !== entity.id)
      .map((e: any) => {
        const sameType = e.type === entity.type ? 2 : 0;
        const sharedWork = (e.works || []).some((w: string) => (entity.works || []).includes(w)) ? 1 : 0;
        return { e, score: sameType + sharedWork };
      })
      .filter((s: any) => s.score > 0)
      .sort((a: any, b: any) => b.score - a.score || String(a.e.nameZh).localeCompare(String(b.e.nameZh), 'zh'))
      .slice(0, 9)
      .map((s: any) => s.e)
  : [];

const description = clip(`${entity.nameZh}（${typeLabels[entity.type] || '词条'}）：${entity.summary}`, 115);
const shareImage = appearedWorks.length > 0 ? workCover(appearedWorks[0]) : null;

// D1：词条页顶部插图（数据里写文件名，图片不存在就自动不渲染）
const scenes = (entity.images || [])
  .map((img: any) => ({ ...img, src: scenePath(img.file) }))
  .filter((img: any) => img.src);

// F5：结构化数据（词条页 → DefinedTerm）
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: entity.nameZh,
  ...(entity.nameEn || (entity.aliases || []).length
    ? { alternateName: [entity.nameEn, ...(entity.aliases || [])].filter(Boolean) }
    : {}),
  url: abs(`/entity/${entity.id}/`),
  description: clip(entity.summary, 160),
  inLanguage: 'zh-CN',
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: `${pack.series.nameZh} · 词条表`,
    url: abs(`/series/${pack.id}/`),
  },
};
---

<BaseLayout title={`${entity.nameZh} · 词条`} theme={theme} description={description} image={shareImage} type="article" jsonLd={jsonLd}>
  <p class="eyebrow">{typeLabels[entity.type] || '词条'} · ENTITY</p>
  <h1>{entity.nameZh} <span class="title-en">{entity.nameEn}</span></h1>
  <p class="lead">{entity.summary}</p>
  <div class="meta-row">
    {appearedWorks.map((w: any) => <a class="tag tag--link" href={`/work/${w.id}/`}>登场：{w.title}</a>)}
  </div>

  {
    scenes.length > 0 && (
      <div class="scene-list">
        {scenes.map((img: any) => (
          <figure class="scene">
            <img src={img.src} alt={img.caption || `${entity.nameZh} 氛围插画`} loading="lazy" />
            <figcaption class="scene__cap">
              {img.caption}
              <span class="scene__src">
                来源：{img.sourceUrl
                  ? <a href={img.sourceUrl} target="_blank" rel="noopener noreferrer">{img.source || DEFAULT_IMAGE_SOURCE}</a>
                  : (img.source || DEFAULT_IMAGE_SOURCE)}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    )
  }

  <h2>档案</h2>
  <table class="facts">
    <tbody>
      {factKeys.map((k) => (
        <tr>
          <th>{k}</th>
          <td>{entity.facts[k]}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>简介</h2>
  <div class="panel prose">
    <p set:html={linkify(entity.bio, index, new Set())} />
  </div>

  {
    entity.deeds && entity.deeds.length > 0 && (
      <section>
        <h2>事迹经历</h2>
        <div class="panel prose">
          <ol class="deeds">
            {entity.deeds.map((d: string) => <li set:html={linkify(d, index, new Set())} />)}
          </ol>
        </div>
      </section>
    )
  }

  {
    relations.length > 0 && (
      <section>
        <h2>关联词条</h2>
        <div class="rel-list">
          {relations.map((r: any) => (
            <a class="rel" href={`/entity/${r.entity.id}/`}>
              <span class="rel__name">{r.entity.nameZh}</span>
              <span class="rel__label">{r.label}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    relatedDocs.length > 0 && (
      <section>
        <h2>相关档案</h2>
        <div class="doc-list">
          {relatedDocs.map(({ doc, work }: any) => (
            <a class="doc" href={`/work/${work.id}/#doc-${doc.id}`}>
              <div class="doc__head">
                <span class="doc__no">{docTypeLabel(doc.type)} {String(doc.no).padStart(2, '0')}</span>
                <h3 class="doc__title">{doc.nameZh}</h3>
                <span class="doc__en">{doc.nameEn}</span>
              </div>
              <p class="doc__summary">{doc.summary}</p>
              <span class="doc__from">出自《{work.title}》· {doc.chapter} →</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
  {
    isOrphan && suggestions.length > 0 && (
      <section>
        <h2>继续浏览</h2>
        <p class="lead">
          本词条暂无额外关联，下面列出同系列中「类型相同」或「有共同登场作品」的词条，供继续浏览。
        </p>
        <div class="meta-row">
          <a class="tag tag--link" href={`/series/${pack.id}/`}>回到 {pack.series.nameZh} 系列页</a>
        </div>
        <div class="grid grid--3 suggest-list">
          {suggestions.map((e: any) => (
            <a class="card" href={`/entity/${e.id}/`}>
              <div class="card__index">{typeLabels[e.type] || '词条'}</div>
              <h3 class="card__title">{e.nameZh}</h3>
              {e.nameEn && <div class="card__en">{e.nameEn}</div>}
              <p class="card__desc">{e.summary}</p>
              <div class="card__foot">查看词条 →</div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .title-en {
    font-size: 15px;
    color: var(--dim);
    font-family: var(--sans);
    letter-spacing: 0.06em;
    font-weight: 400;
    margin-left: 6px;
  }
  .tag--link { text-decoration: none; transition: color 0.15s, border-color 0.15s; }
  .tag--link:hover { color: var(--blood-bright); border-color: rgba(var(--accent-rgb), 0.45); }

  /* C6：孤岛词条的兜底推荐 */
  .suggest-list { margin-top: 16px; }

  .facts {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background: var(--panel);
    border: 1px solid var(--line);
  }
  .facts th {
    width: 130px;
    text-align: left;
    vertical-align: top;
    padding: 10px 16px;
    color: var(--muted);
    font-weight: 400;
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    background: var(--panel-2); /* 随主题走（原为写死的冷灰，在尸体派对暖色主题上是块突兀的灰） */
    white-space: nowrap;
  }
  .facts td {
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    color: #c9c6c0;
  }
  .facts tr:last-child th, .facts tr:last-child td { border-bottom: none; }

  .deeds { margin: 0; padding-left: 22px; }
  .deeds li { margin-bottom: 10px; color: #c9c6c0; font-size: 14.5px; }
  .deeds li:last-child { margin-bottom: 0; }

  .rel-list { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .rel {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px 16px;
    transition: border-color 0.15s, background 0.15s;
  }
  .rel:hover { border-color: rgba(var(--accent-rgb), 0.5); background: var(--panel-2); }
  .rel__name { font-family: var(--serif); font-size: 15px; color: var(--text); }
  .rel__label { font-size: 12.5px; color: var(--muted); }

  .doc-list { display: flex; flex-direction: column; gap: 12px; }
  .doc {
    display: block;
    text-decoration: none;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid rgba(var(--accent-rgb), 0.55);
    border-radius: var(--radius);
    padding: 14px 18px;
    transition: border-color 0.15s, background 0.15s;
  }
  .doc:hover { background: var(--panel-2); border-color: rgba(var(--accent-rgb), 0.5); }
  .doc__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .doc__no {
    font-family: Georgia, serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--blood-bright);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 999px;
    padding: 0 8px;
  }
  .doc__title { margin: 0; font-size: 15.5px; color: var(--text); }
  .doc__en { font-size: 12px; color: var(--dim); }
  .doc__summary { font-size: 14px; color: var(--muted); margin: 8px 0 6px; }
  .doc__from { font-size: 12px; color: var(--blood-bright); }

  /* E3：窄屏把「标签 / 值」两列压成上下两行，不再横向挤 */
  @media (max-width: 640px) {
    .facts, .facts tbody, .facts tr, .facts th, .facts td { display: block; width: auto; }
    .facts th {
      border-right: none;
      border-bottom: none;
      padding: 9px 14px 2px;
      white-space: normal;
    }
    .facts td { padding: 0 14px 11px; }
    .facts tr { border-bottom: 1px solid var(--line); }
    .facts tr:last-child { border-bottom: none; }
  }
</style>
