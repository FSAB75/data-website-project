---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  seriesList,
  arsenalOfSeries,
  coverPath,
  getEntity,
  arsenalImage,
  DEFAULT_GALLERY_SOURCE,
} from '../../../lib/data.js';

// 只为「有武器 / 能力类收集条目」的系列生成该子页
export function getStaticPaths() {
  return seriesList
    .filter((s) => arsenalOfSeries(s.id).length > 0)
    .map((s) => ({ params: { id: s.id }, props: { pack: s } }));
}

const { pack } = Astro.props;
const item = pack.series;
const rawList = arsenalOfSeries(pack.id);

// 数值字段的展示顺序与中文标签（数据里没有的字段自动跳过）
const SPEC_LABELS = [
  ['model', '原型型号'],
  ['ammo', '弹种'],
  ['magazine', '弹容'],
  ['damage', '伤害'],
  ['fireRate', '射速'],
  ['reload', '装填'],
  ['upgrades', '改装分支'],
  ['exclusive', '专属强化'],
];

// 逐型号解析：把配图文件名换成真实路径（文件不存在就丢掉这一张），并整理出展示用的字段行
function resolveModels(doc) {
  return (doc.models || []).map((m) => ({
    key: m.key || m.nameZh,
    nameZh: m.nameZh,
    nameEn: m.nameEn || '',
    ver: m.ver || '',
    specs: SPEC_LABELS.map(([k, label]) => [label, m[k]]).filter(([, v]) => v),
    note: m.note || '',
    shots: (m.images || [])
      .map((im) => ({ ver: im.ver || '', src: arsenalImage(im.file) }))
      .filter((s) => s.src),
    sources: (m.sources || []).map((u) => ({ url: u, label: hostLabel(u) })),
  }));
}

function hostLabel(url) {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}

const list = rawList.map((d) => {
  const models = resolveModels(d);
  // 卡片顶部的缩略条：每个型号挑一张（优先重制版，其次原版），最多 8 张
  const thumbs = [];
  for (const m of models) {
    const pick = m.shots.find((s) => s.ver === '重制版') || m.shots[0];
    if (pick) thumbs.push({ src: pick.src, alt: `${m.nameZh} 配图` });
    if (thumbs.length >= 8) break;
  }
  // 条目自带的配图（敌人 / 首领条目用）
  const gallery = (d.images || [])
    .map((im) => ({ src: arsenalImage(im.file), caption: im.caption, source: im.source, sourceUrl: im.sourceUrl }))
    .filter((im) => im.src);
  const searchText = [d.nameZh, d.nameEn, d.no, d.summary, ...models.map((m) => `${m.nameZh} ${m.nameEn}`)]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  return { ...d, models, thumbs, gallery, searchText };
});

const modelTotal = list.reduce((n, d) => n + d.models.length, 0);

// 类别顺序：武器 → 武器变体 → 能力 → 技能 → 疯狂技能（缺的类别自动跳过）
const TYPE_ORDER = ['武器', '武器变体', '能力', '技能', '疯狂技能'];
const uniq = (arr) => [...new Set(arr.filter(Boolean))];
const typeOptions = uniq([...TYPE_ORDER.filter((t) => list.some((d) => d.type === t)), ...list.map((d) => d.type)]);
const byType = Object.fromEntries(typeOptions.map((t) => [t, list.filter((d) => d.type === t).length]));

const workIds = uniq(list.map((d) => d.workId));
const workOptions = workIds.map((id) => {
  const w = pack.works.find((x) => x.id === id);
  return { id, title: w ? w.title : id, year: w ? w.year : '' };
});
const workTitleOf = Object.fromEntries(workOptions.map((w) => [w.id, w.title]));

const weaponCount = list.filter((d) => d.type === '武器').length;
const abilityCount = list.filter((d) => d.type !== '武器').length;

// 配图来源按系列标注（页面是通用的，不同系列的素材站不同）
const GALLERY_SOURCES = {
  'resident-evil': 'Evil Resource（evilresource.com）的逐武器页',
  'forgive-me-father': 'Forgive Me Father Wiki（Fandom）的拾取 / 实机截图',
};
const gallerySource = GALLERY_SOURCES[pack.id] || DEFAULT_GALLERY_SOURCE;

const description = `${item.nameZh}系列武器与能力图鉴：汇总全系列 ${list.length} 条武器、变体与能力条目，可按作品、类别与关键词筛选。`;
const shareImage = coverPath('series', item.id);
---

<BaseLayout title={`武器与能力图鉴 · ${item.nameZh}`} theme={item.theme} description={description} image={shareImage}>
  <p class="eyebrow">SPECIAL · 武器与能力图鉴</p>
  <h1>武器与能力图鉴 <span class="title-en">Arsenal &amp; Abilities</span></h1>
  <p class="lead">
    本页把全系列已收录的<strong>武器、武器变体与能力</strong>条目汇总成一页，可按作品、类别与关键词筛选。
    条目内容整理自公开资料，<strong>只做概括性转述</strong>，不复制游戏内原文。
  </p>
  <div class="meta-row">
    <span class="tag tag--blood">{list.length} 条条目</span>
    <span class="tag">{weaponCount} 件武器</span>
    {modelTotal > 0 && <span class="tag">{modelTotal} 个具体型号</span>}
    <span class="tag">{abilityCount} 项能力 / 变体</span>
    <span class="tag">{workOptions.length} 部作品有收录</span>
  </div>

  <section class="ar-summary">
    {typeOptions.map((t) => (
      <span class="ar-sum" data-type={t}>
        <span class="ar-sum__n">{byType[t]}</span>
        <span class="ar-sum__l">{t}</span>
      </span>
    ))}
  </section>

  <!-- 窄屏用这个按钮收放筛选栏（原生 checkbox，零 JS）；宽屏整块不显示 -->
  <input type="checkbox" id="ar-filter-toggle" class="ar-toggle" aria-controls="ar-filter-panel" />
  <label for="ar-filter-toggle" class="ar-toggle-btn">筛选</label>

  <section class="ar-filters" id="ar-filter-panel" aria-label="筛选">
    <label class="ar-filter">
      <span>作品</span>
      <select data-filter="work">
        <option value="">全部</option>
        {workOptions.map((w) => <option value={w.id}>{w.title}</option>)}
      </select>
    </label>
    <label class="ar-filter">
      <span>类别</span>
      <select data-filter="type">
        <option value="">全部</option>
        {typeOptions.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
    <label class="ar-filter ar-filter--q">
      <span>搜索</span>
      <input type="search" data-filter="q" placeholder="名称 / 型号 / 编号 / 关键词" />
    </label>
    <button type="button" class="ar-reset" data-reset>重置</button>
    <span class="ar-count" data-count>显示 {list.length} / {list.length} 条</span>
  </section>

  <div class="ar-applied" data-applied hidden></div>

  <div class="ar-grid" data-grid>
    {
      list.map((d) => (
        <article
          class="ar-card"
          id={`ar-${d.id}`}
          data-work={d.workId}
          data-type={d.type}
          data-name={d.searchText}
        >
          <header class="ar-card__head">
            <span class="ar-card__no">{d.type} {String(d.no).padStart(2, '0')}</span>
            <span class="ar-card__work">{workTitleOf[d.workId]}</span>
          </header>

          {(d.thumbs.length > 0 || d.gallery.length > 0) && (
            <div class="ar-card__shots">
              {d.thumbs.map((t) => <img class="ar-shot" src={t.src} alt={t.alt} loading="lazy" width="450" height="360" />)}
              {d.gallery.map((g) => <img class="ar-shot ar-shot--wide" src={g.src} alt={g.caption || d.nameZh} loading="lazy" width="450" height="360" />)}
            </div>
          )}

          <h3 class="ar-card__name">{d.nameZh}</h3>
          {d.nameEn && <div class="ar-card__en">{d.nameEn}</div>}
          <p class="ar-card__summary">{d.summary}</p>

          {d.models.length > 0 && (
            <details class="ar-models">
              <summary>
                <span class="ar-models__t">{d.models.length} 个型号</span>
                <span class="ar-models__h">查看数值 · 配图 · 来源</span>
              </summary>
              <ol class="ar-models__list">
                {d.models.map((m) => (
                  <li class="ar-model">
                    <div class="ar-model__head">
                      <div class="ar-model__title">
                        <span class="ar-model__name">
                          {m.nameZh}
                          {m.ver && <span class="ar-model__ver">{m.ver}</span>}
                        </span>
                        {m.nameEn && m.nameEn !== m.nameZh && <span class="ar-model__en">{m.nameEn}</span>}
                      </div>
                      {m.shots.length > 0 && (
                        <div class="ar-model__shots">
                          {m.shots.map((s) => (
                            <figure class="ar-model__shot">
                              <img src={s.src} alt={`${m.nameZh} 配图`} loading="lazy" width="450" height="360" />
                              {s.ver && <figcaption>{s.ver}</figcaption>}
                            </figure>
                          ))}
                        </div>
                      )}
                    </div>
                    <dl class="ar-model__specs">
                      {m.specs.map(([label, value]) => (
                        <div class="ar-model__spec">
                          <dt>{label}</dt>
                          <dd>{value}</dd>
                        </div>
                      ))}
                    </dl>
                    {m.note && <p class="ar-model__note">{m.note}</p>}
                    {m.sources.length > 0 && (
                      <p class="ar-model__src">
                        来源：
                        {m.sources.map((s, i) => (
                          <>
                            {i > 0 && ' · '}
                            <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                          </>
                        ))}
                      </p>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          )}

          {d.gallery.length > 0 && (
            <p class="ar-card__src">
              配图来源：
              {d.gallery.map((g, i) => (
                <>
                  {i > 0 && ' · '}
                  {g.sourceUrl
                    ? <a href={g.sourceUrl} target="_blank" rel="noopener noreferrer">{g.source || DEFAULT_GALLERY_SOURCE}</a>
                    : (g.source || DEFAULT_GALLERY_SOURCE)}
                </>
              ))}
            </p>
          )}

          <footer class="ar-card__foot">
            {d.chapter && <span class="tag">{d.chapter}</span>}
            {d.location && d.location !== '未明确' && <span class="tag">{d.location}</span>}
            {d.relatedEntity && getEntity(d.relatedEntity) && d.relatedEntity.startsWith(`${pack.id}-`) && (
              <a class="chip" href={`/entity/${d.relatedEntity}/`}>{getEntity(d.relatedEntity)!.nameZh}</a>
            )}
          </footer>
        </article>
      ))
    }
  </div>

  <p class="ar-empty" data-empty hidden>没有符合条件的条目，试试放宽筛选条件。</p>

  <section class="ar-notes">
    <h2>收录说明</h2>
    <div class="panel prose">
      <ul>
        <li>本页条目由各作品的「收集资料」派生而来，<strong>只收录公开资料能支撑的内容</strong>。</li>
        <li>
          <strong>型号与数值：</strong>已深化的作品会把「手枪」这类通用条目细化为<strong>具体型号</strong>，
          并列出弹种、弹容、伤害、射速、装填与专属强化的面板数值。数值一律标明来源，查不到的直接写「公开来源未收录」，
          <strong>不做估算与补全</strong>。
        </li>
        {pack.id === 'resident-evil' && (
          <li>
            <strong>两版数值不可直接横向比较：</strong>以《生化危机4》为例，2005 原版的射速 / 装填以「秒」计（越小越快），
            2023 重制版则用界面标量（越大越快），方向相反；伤害都是游戏内相对倍率，不是绝对 HP 伤害。
          </li>
        )}
        {pack.id === 'forgive-me-father' && (
          <li>
            <strong>本系列没有换弹动作：</strong>第 1 作官方描述即为 non-reloading weapons，武器只消耗弹药储备；
            第 2 作改为有限携行，两作的手感差异以游戏本体为准。
          </li>
        )}
        <li>
          <strong>配图：</strong>来自公开游戏资料站（{gallerySource}）与官方宣传片截取的实机画面，
          <strong>非本站原创、非官方授权</strong>，每张图均在条目内标注来源与原始页面链接。
          配图按游戏本身的形象收录，怪物与活体武器可能带血迹或残缺表现；并非每个型号都有图。
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .title-en {
    font-size: 16px;
    color: var(--dim);
    font-family: var(--sans);
    letter-spacing: 0.06em;
    font-weight: 400;
    margin-left: 6px;
  }

  /* ---------- 类别概览（本身也是筛选快捷键） ---------- */
  .ar-summary { display: flex; flex-wrap: wrap; gap: 10px; margin: 26px 0 22px; }
  .ar-sum {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 6px 13px;
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-left-color: rgba(var(--accent-rgb), 0.6);
    border-radius: var(--radius);
    background: var(--panel);
    cursor: pointer;
    user-select: none;
  }
  .ar-sum:hover { background: var(--panel-2); }
  .ar-sum__n { font-family: var(--serif); font-size: 19px; color: var(--text); }
  .ar-sum__l { font-size: 12.5px; color: var(--muted); }

  /* ---------- 筛选栏 ---------- */
  .ar-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    padding: 16px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 22px;
  }
  .ar-filter { display: flex; flex-direction: column; gap: 5px; font-size: 12px; color: var(--dim); }
  .ar-filter select,
  .ar-filter input {
    font: inherit;
    font-size: 13.5px;
    color: var(--text);
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 5px 10px;
    min-width: 132px;
  }
  .ar-filter--q input { min-width: 210px; }
  .ar-filter select:focus,
  .ar-filter input:focus { outline: none; border-color: var(--blood); }
  .ar-reset, .ar-count { font: inherit; font-size: 12.5px; color: var(--muted); }
  .ar-reset {
    cursor: pointer;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 6px 14px;
    transition: color 0.15s, border-color 0.15s;
  }
  .ar-reset:hover { color: var(--blood-bright); border-color: rgba(var(--accent-rgb), 0.5); }
  .ar-count { margin-left: auto; padding-bottom: 6px; }

  .ar-applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .ar-chip {
    font: inherit;
    font-size: 12.5px;
    color: var(--blood-bright);
    background: rgba(var(--accent-deep-rgb), 0.12);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 999px;
    padding: 3px 12px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .ar-chip:hover { border-color: var(--blood-bright); background: rgba(var(--accent-deep-rgb), 0.22); }
  .ar-chip__x { font-size: 10px; opacity: 0.8; }
  .ar-chip--all { color: var(--muted); background: var(--panel-2); border-color: var(--line); }
  .ar-chip--all:hover { color: var(--text); border-color: var(--line); background: var(--panel-3); }

  /* ---------- 条目卡片墙 ---------- */
  .ar-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .ar-card {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid rgba(var(--accent-rgb), 0.55);
    border-radius: var(--radius);
    padding: 14px 18px 12px;
    transition: border-color 0.15s, background 0.15s;
    scroll-margin-top: 132px;
  }
  .ar-card:hover { background: var(--panel-2); }
  .ar-card[hidden] { display: none; }
  .ar-card__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .ar-card__no {
    font-family: var(--serif);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--blood-bright);
  }
  .ar-card__work { font-size: 11px; color: var(--dim); text-align: right; }
  .ar-card__name { font-family: var(--serif); font-size: 17px; margin: 0 0 2px; }
  .ar-card__en { font-size: 11.5px; color: var(--dim); letter-spacing: 0.03em; margin-bottom: 8px; }
  .ar-card__summary { margin: 0 0 10px; font-size: 13px; color: var(--muted); line-height: 1.7; }
  .ar-card__foot { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .chip {
    font-size: 12px;
    text-decoration: none;
    color: var(--blood-bright);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 999px;
    padding: 1px 9px;
  }

  /* ---------- 配图 ---------- */
  .ar-card__shots {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 10px;
    padding: 8px 10px;
    background: radial-gradient(circle at 50% 40%, var(--panel-3), var(--panel-2));
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  /* 道具渲染图是透明底的 450×360，按宽度自适应铺排 */
  .ar-shot {
    flex: 0 0 auto;
    width: 56px;
    height: 45px;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.55));
  }
  .ar-shot--wide {
    width: 76px;
    height: 61px;
  }

  .ar-card__src {
    margin: 8px 0 10px;
    font-size: 11.5px;
    color: var(--dim);
    line-height: 1.6;
  }
  .ar-card__src a { color: var(--blood-bright); text-decoration: none; border-bottom: 1px dotted rgba(var(--accent-rgb), 0.5); }
  .ar-card__src a:hover { border-bottom-style: solid; }

  /* ---------- 型号明细（原生 details，零 JS） ---------- */
  .ar-models {
    margin: 0 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel-2);
  }
  .ar-models > summary {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 12px;
    cursor: pointer;
    list-style: none;
  }
  .ar-models > summary::-webkit-details-marker { display: none; }
  .ar-models > summary::before {
    content: '▸';
    font-size: 10px;
    color: var(--blood-bright);
    transition: transform 0.15s;
  }
  .ar-models[open] > summary::before { transform: rotate(90deg); }
  .ar-models__t { font-size: 12.5px; color: var(--text); }
  .ar-models__h { font-size: 11.5px; color: var(--dim); margin-left: auto; }
  .ar-models > summary:hover .ar-models__t { color: var(--blood-bright); }

  .ar-models__list {
    margin: 0;
    padding: 0 12px 12px;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .ar-model {
    padding: 10px 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 2px solid rgba(var(--accent-rgb), 0.45);
    border-radius: var(--radius);
  }
  .ar-model__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 9px;
  }
  .ar-model__title { display: flex; flex-direction: column; gap: 2px; }
  .ar-model__name { font-family: var(--serif); font-size: 15px; color: var(--text); }
  .ar-model__ver {
    margin-left: 6px;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--blood-bright);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 999px;
    padding: 1px 6px;
    vertical-align: 2px;
  }
  .ar-model__en { font-size: 11px; color: var(--dim); letter-spacing: 0.03em; }

  .ar-model__shots { display: flex; gap: 8px; flex: 0 0 auto; }
  .ar-model__shot { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .ar-model__shot img {
    width: 64px;
    height: 51px;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.55));
  }
  .ar-model__shot figcaption { font-size: 10px; color: var(--dim); }

  .ar-model__specs {
    margin: 0;
    display: grid;
    gap: 4px 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .ar-model__spec { display: flex; gap: 8px; font-size: 12.5px; line-height: 1.65; }
  .ar-model__spec dt {
    flex: 0 0 auto;
    min-width: 62px;
    color: var(--dim);
  }
  .ar-model__spec dd { margin: 0; color: var(--muted); }

  .ar-model__note {
    margin: 8px 0 0;
    padding-top: 8px;
    border-top: 1px dashed var(--line);
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.7;
  }
  .ar-model__src { margin: 6px 0 0; font-size: 11.5px; color: var(--dim); }
  .ar-model__src a { color: var(--blood-bright); text-decoration: none; border-bottom: 1px dotted rgba(var(--accent-rgb), 0.5); }
  .ar-model__src a:hover { border-bottom-style: solid; }

  .ar-empty {
    margin: 26px 0 0;
    padding: 22px;
    text-align: center;
    color: var(--dim);
    font-size: 14px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }
  .ar-notes ul { margin: 0; padding-left: 20px; }
  .ar-notes li { color: var(--muted); font-size: 14px; margin-bottom: 8px; }

  /* 窄屏：筛选栏可折叠（原生 checkbox，零 JS），控件占满宽度 */
  .ar-toggle, .ar-toggle-btn { display: none; }

  @media (pointer: coarse) {
    .ar-sum { min-height: 44px; padding: 10px 16px; }
    .ar-chip, .ar-reset { min-height: 38px; }
    .ar-filter select, .ar-filter input { min-height: 44px; font-size: 15px; }
  }

  @media (max-width: 640px) {
    .ar-toggle {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      margin: 0;
    }
    .ar-toggle-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      min-height: 44px;
      margin-bottom: 10px;
      padding: 11px 14px;
      font-size: 14px;
      color: var(--text);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      cursor: pointer;
    }
    .ar-toggle-btn::after { content: '展开'; margin-left: auto; font-size: 12px; color: var(--dim); }
    .ar-toggle:checked + .ar-toggle-btn { border-color: rgba(var(--accent-rgb), 0.5); }
    .ar-toggle:checked + .ar-toggle-btn::after { content: '收起'; }
    .ar-toggle:focus-visible + .ar-toggle-btn { outline: 2px solid rgba(var(--accent-rgb), 0.7); outline-offset: 2px; }

    .ar-filter, .ar-reset { display: none; }
    .ar-toggle:checked ~ .ar-filters .ar-filter { display: flex; }
    .ar-toggle:checked ~ .ar-filters .ar-reset { display: inline-block; }

    .ar-filter select, .ar-filter input, .ar-filter--q input { min-width: 100%; }
    .ar-filter { width: 100%; }
    .ar-filters { padding: 12px 14px; margin-bottom: 14px; }
    .ar-count { margin-left: 0; }

    .ar-summary { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
    .ar-sum { flex: 0 0 auto; }
  }
</style>

<script>
  // 纯前端筛选：不匹配的卡片直接 hidden；筛选条件同步到 URL（?work=&type=&q=），可分享、刷新不丢。
  const selects = [...document.querySelectorAll('select[data-filter]')];
  const search = document.querySelector('input[data-filter="q"]');
  const cards = [...document.querySelectorAll('.ar-card')];
  const countEl = document.querySelector('[data-count]');
  const emptyEl = document.querySelector('[data-empty]');
  const appliedEl = document.querySelector('[data-applied]');

  const KEYS = ['work', 'type'];
  const LABELS = { work: '作品', type: '类别', q: '搜索' };

  const escapeHtml = (s) =>
    String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const norm = (s) => String(s == null ? '' : s).normalize('NFKC').trim();

  const findSelect = (key) => selects.find((s) => s.dataset.filter === key);
  const pick = (key) => {
    const el = findSelect(key);
    return el ? el.value : '';
  };
  const setPick = (key, value) => {
    const el = findSelect(key);
    if (!el) return;
    el.value = norm(value);
    if (el.value !== norm(value)) el.value = '';
  };

  function readUrl() {
    const p = new URLSearchParams(location.search);
    for (const key of KEYS) {
      const v = p.get(key);
      if (v) setPick(key, v);
    }
    if (search) search.value = p.get('q') || '';
  }

  function writeUrl() {
    const p = new URLSearchParams();
    for (const key of KEYS) {
      const v = pick(key);
      if (v) p.set(key, v);
    }
    const q = search ? search.value.trim() : '';
    if (q) p.set('q', q);
    const qs = p.toString();
    history.replaceState(null, '', qs ? '?' + qs : location.pathname);
  }

  function matches(card) {
    const work = norm(pick('work'));
    const type = norm(pick('type'));
    const q = search ? search.value.trim().toLowerCase() : '';
    return (
      (!work || norm(card.dataset.work) === work) &&
      (!type || norm(card.dataset.type) === type) &&
      (!q || card.dataset.name.includes(q))
    );
  }

  function renderApplied() {
    if (!appliedEl) return;
    const parts = KEYS.map((key) => {
      const el = findSelect(key);
      if (!el || !el.value) return null;
      const opt = el.options[el.selectedIndex];
      const text = opt && opt.textContent ? opt.textContent : el.value;
      return `<button type="button" class="ar-chip" data-clear="${key}">${LABELS[key]}：${escapeHtml(text)} <span class="ar-chip__x">✕</span></button>`;
    }).filter(Boolean);
    const q = search ? search.value.trim() : '';
    if (q) parts.push(`<button type="button" class="ar-chip" data-clear="q">${LABELS.q}：${escapeHtml(q)} <span class="ar-chip__x">✕</span></button>`);
    if (!parts.length) {
      appliedEl.hidden = true;
      appliedEl.innerHTML = '';
      return;
    }
    appliedEl.hidden = false;
    appliedEl.innerHTML =
      '<span>当前筛选：</span>' + parts.join('') +
      '<button type="button" class="ar-chip ar-chip--all" data-clear="__all">清空全部</button>';
  }

  function apply() {
    const hits = cards.filter(matches);
    for (const card of cards) card.hidden = true;
    for (const card of hits) card.hidden = false;
    if (countEl) countEl.textContent = `显示 ${hits.length} / ${cards.length} 条`;
    if (emptyEl) emptyEl.hidden = hits.length !== 0;
    renderApplied();
  }

  function applyFresh() {
    apply();
    writeUrl();
  }

  readUrl();

  for (const el of selects) el.addEventListener('change', applyFresh);
  if (search) search.addEventListener('input', applyFresh);

  if (appliedEl) {
    appliedEl.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-clear]');
      if (!btn) return;
      const key = btn.dataset.clear;
      if (key === '__all') {
        for (const el of selects) el.value = '';
        if (search) search.value = '';
      } else if (key === 'q') {
        if (search) search.value = '';
      } else {
        setPick(key, '');
      }
      applyFresh();
    });
  }

  const reset = document.querySelector('[data-reset]');
  if (reset) {
    reset.addEventListener('click', () => {
      for (const el of selects) el.value = '';
      if (search) search.value = '';
      applyFresh();
    });
  }

  // 顶部类别概览胶囊 = 筛选快捷键
  const typeSelect = findSelect('type');
  if (typeSelect) {
    for (const chip of document.querySelectorAll('.ar-sum[data-type]')) {
      chip.addEventListener('click', () => {
        typeSelect.value = typeSelect.value === chip.dataset.type ? '' : chip.dataset.type;
        applyFresh();
      });
    }
  }

  // 从站内搜索 / 外部链接带 #ar-xxx 进来时，自动展开该卡片的型号明细，否则用户只看到折叠条
  function openTargetCard() {
    const hash = location.hash;
    if (!hash.startsWith('#ar-')) return;
    const card = document.getElementById(hash.slice(1));
    if (!card) return;
    const box = card.querySelector('details.ar-models');
    if (box) box.open = true;
    card.scrollIntoView({ block: 'start', behavior: 'auto' });
  }
  openTargetCard();
  window.addEventListener('hashchange', openTargetCard);

  apply();
</script>
