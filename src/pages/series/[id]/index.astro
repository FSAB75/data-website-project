---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkCard from '../../../components/WorkCard.astro';
import Timeline from '../../../components/Timeline.astro';
import {
  seriesList,
  worksOfSeries,
  entitiesOfSeries,
  timelineOfSeries,
  extraOfSeries,
  coverPath,
  seriesCover,
  clip,
  arsenalOfSeries,
  bestiaryOfSeries,
  extrasOfSeries,
  pathogensOfSeries,
} from '../../../lib/data.js';
import { buildEntityIndex } from '../../../lib/linkify.js';

export function getStaticPaths() {
  return seriesList.map((s) => ({ params: { id: s.id }, props: { pack: s } }));
}

const { pack } = Astro.props;
const item = pack.series;
const index = buildEntityIndex(entitiesOfSeries(pack.id));

const seriesWorks = worksOfSeries(pack.id);
const timeline = timelineOfSeries(pack.id);
const nametags = extraOfSeries(pack.id, 'nametags');

const hero = seriesCover(item);

// B3：卡片改按「推荐阅读顺序」（readingOrder）排列；"order" 仍是系列内编年序，只在时间线里体现
const orderedWorks = [...seriesWorks].sort(
  (a: any, b: any) => (a.readingOrder ?? 99) - (b.readingOrder ?? 99) || (a.order ?? 99) - (b.order ?? 99),
);
const hasReadingOrder = seriesWorks.some((w: any) => w.readingOrder);

// 系列专属子页（有对应扩展数据才显示入口）
const arsenal = arsenalOfSeries(pack.id);
const bestiary = bestiaryOfSeries(pack.id);
const extras = extrasOfSeries(pack.id);
const pathogens = pathogensOfSeries(pack.id);
const pathogenCount = pathogens
  ? (pathogens.pathogenGroups || []).reduce((n: number, g: any) => n + (g.items || []).length, 0)
  : 0;
const bowCount = pathogens
  ? (pathogens.bowGroups || []).reduce((n: number, g: any) => n + (g.items || []).length, 0)
  : 0;
const subPages = [
  nametags && { href: `/series/${item.id}/deaths/`, label: '死法收集图鉴', desc: `收录 ${nametags.nametags.length} 条名牌，可按作品 / 章节 / 学校 / 死法筛选` },
  bestiary.length > 0 && { href: `/series/${item.id}/bestiary/`, label: '怪物与首领图鉴', desc: `汇总 ${bestiary.length} 条敌人与首领条目，可按作品 / 类别筛选` },
  arsenal.length > 0 && { href: `/series/${item.id}/arsenal/`, label: '武器与能力图鉴', desc: `汇总 ${arsenal.length} 条武器、武器变体与能力条目，可按作品 / 类别筛选` },
  extras.length > 0 && { href: `/series/${item.id}/extras/`, label: '关卡与秘密索引', desc: `汇总 ${extras.length} 条关卡结构、玩法系统、隐藏要素与谜题条目，可按作品 / 分类筛选` },
  pathogens && { href: `/series/${item.id}/pathogens/`, label: 'B.O.W. 与病原体谱系', desc: `把 ${pathogenCount} 个病原体 / 计划与 ${bowCount} 种生物兵器按「谁派生自谁」串成一张关系表` },
].filter(Boolean);

// 收录状态：明写「还缺什么」（缺项一律标注，不做虚构补全）
const gaps = item.gaps || [];

const description = clip(`${item.nameZh}（${item.nameEn}）系列百科：${item.intro}`, 115);
---

<BaseLayout title={`${item.nameZh} · 系列`} theme={item.theme} description={description} image={hero}>
  <p class="eyebrow">系列 SERIES</p>
  <h1>{item.nameZh} <span class="title-en">{item.nameEn}</span></h1>
  <p class="lead">{item.intro}</p>
  <div class="meta-row">
    <span class="tag">{item.developer}</span>
    <span class="tag">首作 {item.firstRelease}</span>
    <span class="tag">{seriesWorks.filter((w) => w.full).length} / {seriesWorks.length} 部作品已录入</span>
    <span class="tag">{pack.entities.length} 个词条</span>
    {item.updatedAt && <span class="tag">资料整理 {item.updatedAt}</span>}
  </div>

  {hero && (
    <div class="series-hero">
      <img src={hero} alt={`${item.nameZh}系列氛围插画`} />
      <span class="series-hero__caption">{item.tagline}</span>
    </div>
  )}

  {
    subPages.length > 0 && (
      <section>
        <h2>系列专属</h2>
        <div class="grid grid--2">
          {subPages.map((p: any) => (
            <a class="card" href={p.href}>
              <div class="card__index">SPECIAL</div>
              <h3 class="card__title">{p.label}</h3>
              <p class="card__desc">{p.desc}</p>
              <div class="card__foot">进入 →</div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    hasReadingOrder && (
      <section>
        <h2>推荐阅读顺序</h2>
        <p class="lead">
          按<strong>发售 / 游玩顺序</strong>排列 —— 第一次接触这个系列的人，照这个顺序读即可。
          <span class="dim">（故事内的编年顺序与这里不同，见下方世界观时间线。）</span>
        </p>
        <ol class="ro-list">
          {orderedWorks.map((w: any) => (
            <li class="ro-item">
              {w.keyArt && coverPath('keyart', w.keyArt as string) && (
                <img class="ro-item__art" src={coverPath('keyart', w.keyArt as string)} alt={`${w.title} 官方主视觉`} loading="lazy" />
              )}
              <span class="ro-item__no">{w.readingOrder}</span>
              <span class="ro-item__body">
                <a class="ro-item__title" href={`/work/${w.id}/`}>{w.title}</a>
                <span class="ro-item__meta">{w.year} · {w.type}</span>
                {w.readingNote && <span class="ro-item__note">{w.readingNote}</span>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <h2>作品</h2>
  <p class="lead">按推荐阅读顺序排列；每张卡片标出「建议第 N 个看」。</p>
  <div class="grid grid--2">
    {orderedWorks.map((w: any) => <WorkCard work={w} />)}
  </div>

  {
    (timeline.groups || []).length > 0 && (
      <section>
        <h2>世界观时间线</h2>
        <p class="lead">
          什么时间发生了什么大事件，哪一部作品的哪个角色在经历什么——按时间顺序排列如下。
          <span class="dim">（标绿色为已核实、黄色为推测、灰色为官方未明确。）</span>
        </p>
        <Timeline timeline={timeline} index={index} />
      </section>
    )
  }

  {
    gaps.length > 0 && (
      <section>
        <h2>收录状态</h2>
        <p class="lead">
          本系列的骨架与内容按「可核实程度」分批录入。<span class="dim">（资料本身没写清的，一律标注，不做虚构补全。）</span>
        </p>
        <div class="panel">
          <p class="gaps__head">已知缺口</p>
          <ul class="gaps">
            {gaps.map((g: string) => <li>{g}</li>)}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .title-en {
    font-size: 16px;
    color: var(--dim);
    font-family: var(--sans);
    letter-spacing: 0.06em;
    font-weight: 400;
    margin-left: 6px;
  }
  .dim { color: var(--dim); font-size: 13px; }

  /* B3：推荐阅读顺序 */
  .ro-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ro-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid rgba(var(--accent-rgb), 0.5);
    border-radius: var(--radius);
    padding: 12px 16px;
  }
  .ro-item__no {
    flex: 0 0 auto;
    min-width: 22px;
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.35;
    color: var(--blood-bright);
  }
  .ro-item__art {
    flex: 0 0 auto;
    width: 118px;
    height: 56px;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--panel-3);
  }
  .ro-item__body { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  .ro-item__title {
    font-family: var(--serif);
    font-size: 16px;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .ro-item__title:hover { color: var(--blood-bright); border-bottom-color: var(--blood); }
  .ro-item__meta { font-size: 12.5px; color: var(--dim); }
  .ro-item__note { flex: 1 1 100%; font-size: 13px; color: var(--muted); margin-top: 2px; }

  .series-hero {
    position: relative;
    margin: 26px 0 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 21 / 8;
    background: var(--panel-3);
  }
  .series-hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
  }
  .series-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--overlay-rgb), 0.15) 30%, rgba(var(--overlay-rgb), 0.95) 100%);
    pointer-events: none;
  }
  .series-hero__caption {
    position: absolute;
    left: 22px;
    bottom: 18px;
    z-index: 1;
    font-family: var(--serif);
    font-size: 19px;
    letter-spacing: 0.04em;
    color: var(--text);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
  }

  /* E5：窄屏把 21/8 的横幅改成 16/9（原来在竖屏上被压成一条，封面看不清）；
     顺带把「推荐阅读顺序」缩略图收小，给标题留出宽度 */
  @media (max-width: 640px) {
    .series-hero { aspect-ratio: 16 / 9; }
    .series-hero__caption { left: 14px; bottom: 12px; font-size: 16px; }
    .ro-item { gap: 10px; padding: 12px 14px; }
    .ro-item__art { width: 92px; height: 48px; }
  }
  /* 收录状态（借鉴参考站的「已知缺口」写法）：把缺什么明确写出来 */
  .gaps { margin: 0; padding-left: 20px; }
  .gaps li { color: var(--muted); font-size: 14px; margin-bottom: 7px; }
  .gaps li:last-child { margin-bottom: 0; }
  .gaps__head { margin: 0 0 10px; font-size: 12.5px; letter-spacing: 0.14em; color: var(--blood-bright); }
</style>
