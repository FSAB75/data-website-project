---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { seriesList, extraOfSeries, coverPath } from '../../../lib/data.js';

// 只给「有 nametags 数据」的系列生成该子页（目前是尸体派对）
export function getStaticPaths() {
  return seriesList
    .filter((s) => s.nametags && s.nametags.nametags && s.nametags.nametags.length)
    .map((s) => ({ params: { id: s.id }, props: { pack: s } }));
}

const { pack } = Astro.props;
const item = pack.series;
const data = extraOfSeries(pack.id, 'nametags');
const list = data.nametags;
const deathTypes = data.DEATH_TYPES;
const notes = data.notes || [];

const uniq = (arr) => [...new Set(arr.filter(Boolean))];
const workOptions = uniq(list.map((n) => n.workTitle));
const chapterOptions = uniq(list.map((n) => n.chapter));
const schoolOptions = uniq(list.map((n) => n.school));
const typeOptions = deathTypes.filter((t) => list.some((n) => n.deathType === t.key));

const byType = Object.fromEntries(deathTypes.map((t) => [t.key, list.filter((n) => n.deathType === t.key).length]));

const description = `${item.nameZh}系列死法收集图鉴：汇总全系列 ${list.length} 条名牌，可按作品、章节、就读学校与死法类型筛选，并附死法分布速览。`;
const shareImage = coverPath('series', item.id);
---

<BaseLayout title="死法收集图鉴 · 尸体派对" theme={item.theme} description={description} image={shareImage}>
  <p class="eyebrow">SPECIAL · 死法收集图鉴</p>
  <h1>死法收集图鉴 <span class="title-en">Name Tags</span></h1>
  <p class="lead">
    《尸体派对》系列的「名牌（Name Tag）」是散落在天神小学各处的死者标识，上面写着死者的姓名、年龄、
    就读学校与<strong>死因 / 死法</strong>。本页把全系列已收录的名牌汇总成一页，可按作品、章节、就读学校与死法类型筛选。
  </p>
  <div class="meta-row">
    <span class="tag tag--blood">{list.length} 条名牌</span>
    <span class="tag">{workOptions.length} 部作品有收录</span>
    <span class="tag">{schoolOptions.length} 所学校</span>
    <span class="tag">更新于 {data.generatedAt}</span>
  </div>

  <section class="nt-summary">
    {typeOptions.map((t) => (
      <span class={`nt-sum ${t.key === 'unknown' ? 'nt-sum--dim' : ''}`} data-death={t.key}>
        <span class="nt-sum__n">{byType[t.key]}</span>
        <span class="nt-sum__l">{t.label}</span>
      </span>
    ))}
  </section>

  <section class="nt-filters" aria-label="筛选">
    <label class="nt-filter">
      <span>作品</span>
      <select data-filter="work">
        <option value="">全部</option>
        {workOptions.map((w) => <option value={w}>{w}</option>)}
      </select>
    </label>
    <label class="nt-filter">
      <span>章节</span>
      <select data-filter="chapter">
        <option value="">全部</option>
        {chapterOptions.map((c) => <option value={c}>{c}</option>)}
      </select>
    </label>
    <label class="nt-filter">
      <span>就读学校</span>
      <select data-filter="school">
        <option value="">全部</option>
        {schoolOptions.map((s) => <option value={s}>{s}</option>)}
      </select>
    </label>
    <label class="nt-filter">
      <span>死法类型</span>
      <select data-filter="death">
        <option value="">全部</option>
        {typeOptions.map((t) => <option value={t.key}>{t.label}</option>)}
      </select>
    </label>
    <label class="nt-filter nt-filter--q">
      <span>搜索</span>
      <input type="search" data-filter="q" placeholder="姓名 / 编号 / 死因关键词" />
    </label>
    <button type="button" class="nt-reset" data-reset>重置</button>
    <span class="nt-count" data-count>显示 {list.length} / {list.length} 条</span>
  </section>

  <div class="nt-applied" data-applied hidden></div>
  <p class="nt-notice" data-notice hidden></p>

  <div class="nt-grid" data-grid>
    {
      list.map((n) => (
        <article
          class={`nt-card nt-card--${n.deathType}`}
          id={`nt-${n.id}`}
          data-work={n.workTitle}
          data-chapter={n.chapter}
          data-school={n.school}
          data-death={n.deathType}
          data-name={`${n.nameZh} ${n.nameEn} ${n.id} ${n.cause}`.toLowerCase()}
        >
          <header class="nt-card__head">
            <span class="nt-card__no">{n.id}</span>
            <span class="nt-card__type">{n.deathLabel}</span>
          </header>
          <h3 class="nt-card__name">{n.nameZh}</h3>
          {n.nameEn && <div class="nt-card__en">{n.nameEn}</div>}
          <dl class="nt-card__facts">
            <div>
              <dt>年龄 / 性别</dt>
              <dd>{n.age}{n.gender ? ` · ${n.gender}` : ''}</dd>
            </div>
            <div>
              <dt>就读学校</dt>
              <dd>{n.school || '未载'}{n.schoolEn ? `（${n.schoolEn}）` : ''}</dd>
            </div>
            <div>
              <dt>死因 / 死法</dt>
              <dd class="nt-card__cause">{n.cause}</dd>
            </div>
            <div>
              <dt>章节</dt>
              <dd>{n.chapter}{n.location ? ` · ${n.location}` : ''}</dd>
            </div>
            {n.note && (
              <div>
                <dt>备注</dt>
                <dd>{n.note}</dd>
              </div>
            )}
          </dl>
          <footer class="nt-card__work">{n.workTitle}</footer>
        </article>
      ))
    }
  </div>

  <div class="nt-more-wrap">
    <button type="button" class="nt-more" data-more hidden>显示更多</button>
  </div>

  <p class="nt-empty" data-empty hidden>没有符合条件的名牌，试试放宽筛选条件。</p>

  {
    notes.length > 0 && (
      <section class="nt-notes">
        <h2>收录说明</h2>
        <div class="panel prose">
          <ul>
            {notes.map((t: string) => <li>{t}</li>)}
          </ul>
          <p class="dim">名牌清单整理自公开资料，未收录的条目一律标注「未明确」，未作虚构补全。</p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .title-en {
    font-size: 16px;
    color: var(--dim);
    font-family: var(--sans);
    letter-spacing: 0.06em;
    font-weight: 400;
    margin-left: 6px;
  }
  .dim { color: var(--dim); font-size: 13px; }

  /* ---------- 死法分布概览 ---------- */
  .nt-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 26px 0 22px;
  }
  .nt-sum {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 6px 13px;
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: var(--radius);
    background: var(--panel);
  }
  .nt-sum__n { font-family: var(--serif); font-size: 19px; color: var(--text); }
  .nt-sum__l { font-size: 12.5px; color: var(--muted); }
  .nt-sum--dim { opacity: 0.72; }

  /* ---------- 筛选栏 ---------- */
  .nt-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    padding: 16px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 22px;
  }
  .nt-filter { display: flex; flex-direction: column; gap: 5px; font-size: 12px; color: var(--dim); }
  .nt-filter select,
  .nt-filter input {
    font: inherit;
    font-size: 13.5px;
    color: var(--text);
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 5px 10px;
    min-width: 132px;
  }
  .nt-filter--q input { min-width: 210px; }
  .nt-filter select:focus,
  .nt-filter input:focus { outline: none; border-color: var(--blood); }
  .nt-reset,
  .nt-count {
    font: inherit;
    font-size: 12.5px;
    color: var(--muted);
  }
  .nt-reset {
    cursor: pointer;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 6px 14px;
    transition: color 0.15s, border-color 0.15s;
  }
  .nt-reset:hover { color: var(--blood-bright); border-color: rgba(var(--accent-rgb), 0.5); }
  .nt-count { margin-left: auto; padding-bottom: 6px; }

  /* 已应用的筛选条件：做成可视化胶囊，可单个点掉 —— 分享链接时一眼能看出带了哪些条件 */
  .nt-applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .nt-chip {
    font: inherit;
    font-size: 12.5px;
    color: var(--blood-bright);
    background: rgba(var(--accent-deep-rgb), 0.12);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 999px;
    padding: 3px 12px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .nt-chip:hover { border-color: var(--blood-bright); background: rgba(var(--accent-deep-rgb), 0.22); }
  .nt-chip__x { font-size: 10px; opacity: 0.8; }
  .nt-chip--all { color: var(--muted); background: var(--panel-2); border-color: var(--line); }
  .nt-chip--all:hover { color: var(--text); border-color: var(--line); background: var(--panel-3); }
  .nt-notice {
    margin: 0 0 16px;
    font-size: 13px;
    color: var(--inferred);
    background: rgba(201, 162, 39, 0.08);
    border: 1px solid rgba(201, 162, 39, 0.35);
    border-left: 3px solid var(--inferred);
    border-radius: var(--radius);
    padding: 10px 14px;
  }

  /* ---------- 名牌卡片墙 ---------- */
  .nt-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .nt-card {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--nt-color, var(--line));
    border-radius: var(--radius);
    padding: 14px 18px 12px;
    transition: border-color 0.15s, background 0.15s;
    /* 搜索结果会深链到具体名牌（#nt-NT001），留出吸顶页头的高度 */
    scroll-margin-top: 84px;
  }
  .nt-card:hover { background: var(--panel-2); }
  .nt-card[hidden] { display: none; }
  .nt-card:target { border-color: rgba(var(--accent-rgb), 0.7); background: var(--panel-2); }

  .nt-card--blunt { --nt-color: #8a6f4a; }
  .nt-card--sharp { --nt-color: #a8453c; }
  .nt-card--bleed { --nt-color: #8c2f2a; }
  .nt-card--fall { --nt-color: #5f7a8c; }
  .nt-card--starve { --nt-color: #7a6a45; }
  .nt-card--suicide { --nt-color: #6a5a7a; }
  .nt-card--other { --nt-color: #6d6353; }
  .nt-card--unknown { --nt-color: #43403a; }

  .nt-card__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .nt-card__no {
    font-family: var(--serif);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--dim);
  }
  .nt-card__type {
    font-size: 11px;
    color: var(--nt-color, var(--muted));
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 8px;
    opacity: 0.95;
  }
  .nt-card__name { font-family: var(--serif); font-size: 17px; margin: 0 0 2px; }
  .nt-card__en { font-size: 11.5px; color: var(--dim); letter-spacing: 0.03em; margin-bottom: 10px; }

  .nt-card__facts { margin: 0; font-size: 13px; }
  .nt-card__facts > div {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 8px;
    padding: 3px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  .nt-card__facts dt { color: var(--dim); font-size: 12px; }
  .nt-card__facts dd { margin: 0; color: var(--muted); }
  .nt-card__cause { color: var(--text) !important; }

  .nt-card__work {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--dim);
  }

  .nt-empty {
    margin: 26px 0 0;
    padding: 22px;
    text-align: center;
    color: var(--dim);
    font-size: 14px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }

  .nt-notes ul { margin: 0; padding-left: 20px; }
  .nt-notes li { color: var(--muted); font-size: 14px; margin-bottom: 8px; }

  /* 分批显示：先出前 24 张，需要再点「显示更多」 */
  .nt-more-wrap { display: flex; justify-content: center; margin: 18px 0 4px; }
  .nt-more {
    font: inherit;
    font-size: 13.5px;
    color: var(--blood-bright);
    background: var(--panel);
    border: 1px solid rgba(var(--accent-rgb), 0.45);
    border-radius: 999px;
    padding: 8px 24px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .nt-more:hover { border-color: var(--blood-bright); background: rgba(var(--accent-deep-rgb), 0.2); }

  /* C9：触屏设备上放大筛选控件与可点胶囊（顶部死法分布胶囊本身就是筛选快捷键） */
  @media (pointer: coarse) {
    .nt-sum { min-height: 44px; padding: 10px 16px; }
    .nt-chip, .nt-more, .nt-reset { min-height: 38px; }
    .nt-filter select, .nt-filter input { min-height: 44px; font-size: 15px; }
  }

  @media (max-width: 640px) {
    .nt-filter select, .nt-filter input, .nt-filter--q input { min-width: 100%; }
    .nt-filter { width: 100%; }
    .nt-count { margin-left: 0; }
  }
</style>

<script>
  // 静态站上的纯前端筛选：不匹配的卡片直接 hidden，无需请求后台。
  // C5：① 筛选条件同步到 URL（?work=&chapter=&school=&death=&q=），可分享、刷新不丢；
  //     ② 命中结果先出前 24 张，其余由「显示更多」按批放出来，避免一屏铺 116 张。
  const BATCH = 24;

  const selects = [...document.querySelectorAll('select[data-filter]')];
  const search = document.querySelector('input[data-filter="q"]');
  const cards = [...document.querySelectorAll('.nt-card')];
  const countEl = document.querySelector('[data-count]');
  const emptyEl = document.querySelector('[data-empty]');
  const moreBtn = document.querySelector('[data-more]');
  const appliedEl = document.querySelector('[data-applied]');
  const noticeEl = document.querySelector('[data-notice]');

  let limit = BATCH;

  const KEYS = ['work', 'chapter', 'school', 'death'];
  const LABELS = { work: '作品', chapter: '章节', school: '就读学校', death: '死法类型', q: '搜索' };

  const escapeHtml = (s) =>
    String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  /** 比对前先做兼容归一化：消除全/半角、兼容字符与首尾空白的差异，避免「看着一样却匹配不上」 */
  const norm = (s) => String(s == null ? '' : s).normalize('NFKC').trim();

  const findSelect = (key) => selects.find((s) => s.dataset.filter === key);

  const pick = (key) => {
    const el = findSelect(key);
    return el ? el.value : '';
  };

  /** 设置下拉值：按归一化后的值去找真实选项，找不到就置空并返回 false（让调用方知道这个条件被忽略了） */
  const setPick = (key, value) => {
    const el = findSelect(key);
    if (!el) return false;
    const want = norm(value);
    if (!want) {
      el.value = '';
      return true;
    }
    const hit = [...el.options].find((o) => norm(o.value) === want);
    el.value = hit ? hit.value : '';
    return !!hit;
  };

  /** 从 URL 回填筛选条件（支持直接打开别人分享的筛选链接） */
  function readUrl() {
    const p = new URLSearchParams(location.search);
    const ignored = [];
    for (const key of KEYS) {
      const v = p.get(key);
      if (v && !setPick(key, v)) ignored.push(`${LABELS[key]}「${v}」`);
    }
    if (search) search.value = p.get('q') || '';
    if (noticeEl) {
      noticeEl.hidden = ignored.length === 0;
      if (ignored.length) {
        noticeEl.textContent = `链接中的筛选条件 ${ignored.join('、')} 在本页找不到对应项，已忽略；其余条件照常生效。`;
      }
    }
  }

  /** 把当前筛选写回 URL（replaceState，不污染浏览历史） */
  function writeUrl() {
    const p = new URLSearchParams();
    for (const key of KEYS) {
      const v = pick(key);
      if (v) p.set(key, v);
    }
    const q = search ? search.value.trim() : '';
    if (q) p.set('q', q);
    const qs = p.toString();
    history.replaceState(null, '', qs ? '?' + qs : location.pathname);
  }

  /** 只判断是否命中，不处理显示 */
  function matches(card) {
    const work = norm(pick('work'));
    const chapter = norm(pick('chapter'));
    const school = norm(pick('school'));
    const death = norm(pick('death'));
    const q = search ? search.value.trim().toLowerCase() : '';
    return (
      (!work || norm(card.dataset.work) === work) &&
      (!chapter || norm(card.dataset.chapter) === chapter) &&
      (!school || norm(card.dataset.school) === school) &&
      (!death || norm(card.dataset.death) === death) &&
      (!q || card.dataset.name.includes(q))
    );
  }

  /** 把「当前生效的筛选」渲染成一排可点掉的胶囊，并同步「显示更多」按钮 */
  function renderApplied() {
    if (!appliedEl) return;
    const parts = KEYS.map((key) => {
      const el = findSelect(key);
      if (!el || !el.value) return null;
      const opt = el.options[el.selectedIndex];
      const text = opt && opt.textContent ? opt.textContent : el.value;
      return `<button type="button" class="nt-chip" data-clear="${key}">${LABELS[key]}：${escapeHtml(text)} <span class="nt-chip__x">✕</span></button>`;
    }).filter(Boolean);
    const q = search ? search.value.trim() : '';
    if (q) parts.push(`<button type="button" class="nt-chip" data-clear="q">${LABELS.q}：${escapeHtml(q)} <span class="nt-chip__x">✕</span></button>`);
    if (!parts.length) {
      appliedEl.hidden = true;
      appliedEl.innerHTML = '';
      return;
    }
    appliedEl.hidden = false;
    appliedEl.innerHTML =
      '<span>当前筛选：</span>' +
      parts.join('') +
      '<button type="button" class="nt-chip nt-chip--all" data-clear="__all">清空全部</button>';
  }

  function apply() {
    const hits = cards.filter(matches);
    const shown = hits.slice(0, limit);
    for (const card of cards) card.hidden = true;
    for (const card of shown) card.hidden = false;

    if (countEl) {
      countEl.textContent =
        limit < hits.length
          ? `显示 ${shown.length} / ${hits.length} 条（共收录 ${cards.length} 条）`
          : `显示 ${hits.length} / ${cards.length} 条`;
    }
    if (moreBtn) {
      const rest = hits.length - shown.length;
      moreBtn.hidden = rest <= 0;
      if (rest > 0) moreBtn.textContent = `显示更多（还有 ${rest} 条）`;
    }
    if (emptyEl) emptyEl.hidden = hits.length !== 0;
    renderApplied();
  }

  /** 筛选条件变了：分批进度归零后重新应用 */
  function applyFresh() {
    limit = BATCH;
    if (noticeEl) noticeEl.hidden = true; // URL 已被改写，之前那条「条件被忽略」的提示不再适用
    apply();
    writeUrl();
  }

  readUrl();

  for (const el of selects) el.addEventListener('change', applyFresh);
  if (search) search.addEventListener('input', applyFresh);

  if (moreBtn) moreBtn.addEventListener('click', () => { limit += BATCH; apply(); });

  // 点胶囊上的 ✕ 单独取消某个筛选条件
  if (appliedEl) {
    appliedEl.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-clear]');
      if (!btn) return;
      const key = btn.dataset.clear;
      if (key === '__all') {
        for (const el of selects) el.value = '';
        if (search) search.value = '';
      } else if (key === 'q') {
        if (search) search.value = '';
      } else {
        setPick(key, '');
      }
      applyFresh();
    });
  }

  const reset = document.querySelector('[data-reset]');
  if (reset) {
    reset.addEventListener('click', () => {
      for (const el of selects) el.value = '';
      if (search) search.value = '';
      applyFresh();
    });
  }

  // 顶部「死法分布」胶囊可直接当作筛选快捷键
  const deathSelect = selects.find((s) => s.dataset.filter === 'death');
  if (deathSelect) {
    for (const chip of document.querySelectorAll('.nt-sum[data-death]')) {
      chip.addEventListener('click', () => {
        deathSelect.value = deathSelect.value === chip.dataset.death ? '' : chip.dataset.death;
        applyFresh();
      });
    }
  }

  apply();
</script>
