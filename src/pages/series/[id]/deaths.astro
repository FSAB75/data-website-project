---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { seriesList, extraOfSeries } from '../../../lib/data.js';

// 只给「有 nametags 数据」的系列生成该子页（目前是尸体派对）
export function getStaticPaths() {
  return seriesList
    .filter((s) => s.nametags && s.nametags.nametags && s.nametags.nametags.length)
    .map((s) => ({ params: { id: s.id }, props: { pack: s } }));
}

const { pack } = Astro.props;
const item = pack.series;
const data = extraOfSeries(pack.id, 'nametags');
const list = data.nametags;
const deathTypes = data.DEATH_TYPES;
const notes = data.notes || [];

const uniq = (arr) => [...new Set(arr.filter(Boolean))];
const workOptions = uniq(list.map((n) => n.workTitle));
const chapterOptions = uniq(list.map((n) => n.chapter));
const schoolOptions = uniq(list.map((n) => n.school));
const typeOptions = deathTypes.filter((t) => list.some((n) => n.deathType === t.key));

const byType = Object.fromEntries(deathTypes.map((t) => [t.key, list.filter((n) => n.deathType === t.key).length]));
---

<BaseLayout title="死法收集图鉴 · 尸体派对" theme={item.theme}>
  <p class="eyebrow">SPECIAL · 死法收集图鉴</p>
  <h1>死法收集图鉴 <span class="title-en">Name Tags</span></h1>
  <p class="lead">
    《尸体派对》系列的「名牌（Name Tag）」是散落在天神小学各处的死者标识，上面写着死者的姓名、年龄、
    就读学校与<strong>死因 / 死法</strong>。本页把全系列已收录的名牌汇总成一页，可按作品、章节、就读学校与死法类型筛选。
  </p>
  <div class="meta-row">
    <span class="tag tag--blood">{list.length} 条名牌</span>
    <span class="tag">{workOptions.length} 部作品有收录</span>
    <span class="tag">{schoolOptions.length} 所学校</span>
    <span class="tag">更新于 {data.generatedAt}</span>
  </div>

  <section class="nt-summary">
    {typeOptions.map((t) => (
      <span class={`nt-sum ${t.key === 'unknown' ? 'nt-sum--dim' : ''}`} data-death={t.key}>
        <span class="nt-sum__n">{byType[t.key]}</span>
        <span class="nt-sum__l">{t.label}</span>
      </span>
    ))}
  </section>

  <section class="nt-filters" aria-label="筛选">
    <label class="nt-filter">
      <span>作品</span>
      <select data-filter="work">
        <option value="">全部</option>
        {workOptions.map((w) => <option value={w}>{w}</option>)}
      </select>
    </label>
    <label class="nt-filter">
      <span>章节</span>
      <select data-filter="chapter">
        <option value="">全部</option>
        {chapterOptions.map((c) => <option value={c}>{c}</option>)}
      </select>
    </label>
    <label class="nt-filter">
      <span>就读学校</span>
      <select data-filter="school">
        <option value="">全部</option>
        {schoolOptions.map((s) => <option value={s}>{s}</option>)}
      </select>
    </label>
    <label class="nt-filter">
      <span>死法类型</span>
      <select data-filter="death">
        <option value="">全部</option>
        {typeOptions.map((t) => <option value={t.key}>{t.label}</option>)}
      </select>
    </label>
    <label class="nt-filter nt-filter--q">
      <span>搜索</span>
      <input type="search" data-filter="q" placeholder="姓名 / 编号 / 死因关键词" />
    </label>
    <button type="button" class="nt-reset" data-reset>重置</button>
    <span class="nt-count" data-count>显示 {list.length} / {list.length} 条</span>
  </section>

  <div class="nt-grid" data-grid>
    {
      list.map((n) => (
        <article
          class={`nt-card nt-card--${n.deathType}`}
          data-work={n.workTitle}
          data-chapter={n.chapter}
          data-school={n.school}
          data-death={n.deathType}
          data-name={`${n.nameZh} ${n.nameEn} ${n.id} ${n.cause}`.toLowerCase()}
        >
          <header class="nt-card__head">
            <span class="nt-card__no">{n.id}</span>
            <span class="nt-card__type">{n.deathLabel}</span>
          </header>
          <h3 class="nt-card__name">{n.nameZh}</h3>
          {n.nameEn && <div class="nt-card__en">{n.nameEn}</div>}
          <dl class="nt-card__facts">
            <div>
              <dt>年龄 / 性别</dt>
              <dd>{n.age}{n.gender ? ` · ${n.gender}` : ''}</dd>
            </div>
            <div>
              <dt>就读学校</dt>
              <dd>{n.school || '未载'}{n.schoolEn ? `（${n.schoolEn}）` : ''}</dd>
            </div>
            <div>
              <dt>死因 / 死法</dt>
              <dd class="nt-card__cause">{n.cause}</dd>
            </div>
            <div>
              <dt>章节</dt>
              <dd>{n.chapter}{n.location ? ` · ${n.location}` : ''}</dd>
            </div>
            {n.note && (
              <div>
                <dt>备注</dt>
                <dd>{n.note}</dd>
              </div>
            )}
          </dl>
          <footer class="nt-card__work">{n.workTitle}</footer>
        </article>
      ))
    }
  </div>

  <p class="nt-empty" data-empty hidden>没有符合条件的名牌，试试放宽筛选条件。</p>

  {
    notes.length > 0 && (
      <section class="nt-notes">
        <h2>收录说明</h2>
        <div class="panel prose">
          <ul>
            {notes.map((t: string) => <li>{t}</li>)}
          </ul>
          <p class="dim">名牌清单整理自公开资料，未收录的条目一律标注「未明确」，未作虚构补全。</p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .title-en {
    font-size: 16px;
    color: var(--dim);
    font-family: var(--sans);
    letter-spacing: 0.06em;
    font-weight: 400;
    margin-left: 6px;
  }
  .dim { color: var(--dim); font-size: 13px; }

  /* ---------- 死法分布概览 ---------- */
  .nt-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 26px 0 22px;
  }
  .nt-sum {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 6px 13px;
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: var(--radius);
    background: var(--panel);
  }
  .nt-sum__n { font-family: var(--serif); font-size: 19px; color: var(--text); }
  .nt-sum__l { font-size: 12.5px; color: var(--muted); }
  .nt-sum--dim { opacity: 0.72; }

  /* ---------- 筛选栏 ---------- */
  .nt-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    padding: 16px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 22px;
  }
  .nt-filter { display: flex; flex-direction: column; gap: 5px; font-size: 12px; color: var(--dim); }
  .nt-filter select,
  .nt-filter input {
    font: inherit;
    font-size: 13.5px;
    color: var(--text);
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 5px 10px;
    min-width: 132px;
  }
  .nt-filter--q input { min-width: 210px; }
  .nt-filter select:focus,
  .nt-filter input:focus { outline: none; border-color: var(--blood); }
  .nt-reset,
  .nt-count {
    font: inherit;
    font-size: 12.5px;
    color: var(--muted);
  }
  .nt-reset {
    cursor: pointer;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 6px 14px;
    transition: color 0.15s, border-color 0.15s;
  }
  .nt-reset:hover { color: var(--blood-bright); border-color: rgba(var(--accent-rgb), 0.5); }
  .nt-count { margin-left: auto; padding-bottom: 6px; }

  /* ---------- 名牌卡片墙 ---------- */
  .nt-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .nt-card {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--nt-color, var(--line));
    border-radius: var(--radius);
    padding: 14px 18px 12px;
    transition: border-color 0.15s, background 0.15s;
  }
  .nt-card:hover { background: var(--panel-2); }
  .nt-card[hidden] { display: none; }

  .nt-card--blunt { --nt-color: #8a6f4a; }
  .nt-card--sharp { --nt-color: #a8453c; }
  .nt-card--bleed { --nt-color: #8c2f2a; }
  .nt-card--fall { --nt-color: #5f7a8c; }
  .nt-card--starve { --nt-color: #7a6a45; }
  .nt-card--suicide { --nt-color: #6a5a7a; }
  .nt-card--other { --nt-color: #6d6353; }
  .nt-card--unknown { --nt-color: #43403a; }

  .nt-card__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .nt-card__no {
    font-family: var(--serif);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--dim);
  }
  .nt-card__type {
    font-size: 11px;
    color: var(--nt-color, var(--muted));
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 8px;
    opacity: 0.95;
  }
  .nt-card__name { font-family: var(--serif); font-size: 17px; margin: 0 0 2px; }
  .nt-card__en { font-size: 11.5px; color: var(--dim); letter-spacing: 0.03em; margin-bottom: 10px; }

  .nt-card__facts { margin: 0; font-size: 13px; }
  .nt-card__facts > div {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 8px;
    padding: 3px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  .nt-card__facts dt { color: var(--dim); font-size: 12px; }
  .nt-card__facts dd { margin: 0; color: var(--muted); }
  .nt-card__cause { color: var(--text) !important; }

  .nt-card__work {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--dim);
  }

  .nt-empty {
    margin: 26px 0 0;
    padding: 22px;
    text-align: center;
    color: var(--dim);
    font-size: 14px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }

  .nt-notes ul { margin: 0; padding-left: 20px; }
  .nt-notes li { color: var(--muted); font-size: 14px; margin-bottom: 8px; }

  @media (max-width: 640px) {
    .nt-filter select, .nt-filter input, .nt-filter--q input { min-width: 100%; }
    .nt-filter { width: 100%; }
    .nt-count { margin-left: 0; }
  }
</style>

<script>
  // 静态站上的纯前端筛选：不匹配的卡片直接 hidden，无需请求后台
  const selects = [...document.querySelectorAll('select[data-filter]')];
  const search = document.querySelector('input[data-filter="q"]');
  const cards = [...document.querySelectorAll('.nt-card')];
  const countEl = document.querySelector('[data-count]');
  const emptyEl = document.querySelector('[data-empty]');

  const pick = (key) => {
    const el = selects.find((s) => s.dataset.filter === key);
    return el ? el.value : '';
  };

  function apply() {
    const work = pick('work');
    const chapter = pick('chapter');
    const school = pick('school');
    const death = pick('death');
    const q = search ? search.value.trim().toLowerCase() : '';
    let shown = 0;
    for (const card of cards) {
      const ok =
        (!work || card.dataset.work === work) &&
        (!chapter || card.dataset.chapter === chapter) &&
        (!school || card.dataset.school === school) &&
        (!death || card.dataset.death === death) &&
        (!q || card.dataset.name.includes(q));
      card.hidden = !ok;
      if (ok) shown++;
    }
    if (countEl) countEl.textContent = `显示 ${shown} / ${cards.length} 条`;
    if (emptyEl) emptyEl.hidden = shown !== 0;
  }

  for (const el of selects) el.addEventListener('change', apply);
  if (search) search.addEventListener('input', apply);

  const reset = document.querySelector('[data-reset]');
  if (reset) {
    reset.addEventListener('click', () => {
      for (const el of selects) el.value = '';
      if (search) search.value = '';
      apply();
    });
  }

  // 顶部「死法分布」胶囊可直接当作筛选快捷键
  const deathSelect = selects.find((s) => s.dataset.filter === 'death');
  if (deathSelect) {
    for (const chip of document.querySelectorAll('.nt-sum[data-death]')) {
      chip.addEventListener('click', () => {
        deathSelect.value = deathSelect.value === chip.dataset.death ? '' : chip.dataset.death;
        apply();
      });
    }
  }

  apply();
</script>
