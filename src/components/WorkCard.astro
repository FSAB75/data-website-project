---
import { coverPath } from '../lib/data.js';

interface Props {
  work: any;
}
const { work } = Astro.props;

const cover = coverPath('works', work.id);
---

<a class="card work-card" href={`/work/${work.id}/`}>
  {cover && (
    <div class="card__cover">
      <img src={cover} alt={`${work.title} 氛围插画`} loading="lazy" />
      <span class="card__cover-tag">{work.type}</span>
    </div>
  )}
  <div class="card__index">{work.year} · {work.developer}</div>
  <h3 class="card__title">{work.title}</h3>
  <div class="card__en">{work.titleEn}</div>
  <p class="card__desc">{work.synopsis}</p>
  <div class="meta-row">
    {work.platforms.map((p: string) => <span class="tag">{p}</span>)}
    {!work.full && <span class="tag tag--blood">内容整理中</span>}
  </div>
  <div class="card__foot">查看作品 →</div>
</a>

<style>
  .work-card { padding-top: 0; overflow: hidden; }
  .card__cover {
    position: relative;
    margin: 0 -20px 16px;
    aspect-ratio: 16 / 9;
    background: var(--panel-3);
    overflow: hidden;
  }
  .card__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 0.4s ease, filter 0.3s ease;
  }
  .work-card:hover .card__cover img { transform: scale(1.04); filter: saturate(1) contrast(1.1); }
  .card__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 8, 11, 0) 35%, rgba(8, 8, 11, 0.9) 100%);
    pointer-events: none;
  }
  .card__cover-tag {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 1;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #fff;
    background: rgba(179, 37, 31, 0.85);
    border-radius: 2px;
    padding: 1px 8px;
  }
</style>
