---
import TimelineEvent from './TimelineEvent.astro';

interface Props {
  timeline: any;
  index: any;
}
const { timeline, index } = Astro.props;

const groups = timeline.groups || [];
---

<div class="tl-legend">
  <span class="tag tag--verified">已核实</span>
  <span class="tl-legend__text">有官方资料直接支持</span>
  <span class="tag tag--inferred">推测</span>
  <span class="tl-legend__text">依游戏内顺序合理推断</span>
  <span class="tag">未明确</span>
  <span class="tl-legend__text">官方未给出具体时间</span>
  <span class="tag tag--blood">大事件</span>
  <span class="tl-legend__text">世界线关键节点</span>
</div>

<nav class="tl-index" aria-label="时间线章节导航">
  {groups.map((g: any, i: number) => <a href={`#era-${i}`}>{g.era}</a>)}
</nav>

<div class="tl">
  {
    groups.map((group: any, gi: number) => (
      <section class="tl-group" id={`era-${gi}`}>
        <header class="tl-group__head">
          <h3 class="tl-group__title">{group.era}</h3>
          {group.hint && <p class="tl-group__hint">{group.hint}</p>}
        </header>

        {group.dual ? (
          <>
            <div class="tl-dual">
              {group.tracks.map((track: any) => (
                <div class="tl-col" data-track={track.key}>
                  <div class="tl-col__head">
                    <span class="tl-col__name">{track.name}</span>
                  </div>
                  <div class="tl-col__rail">
                    {track.events.map((ev: any) => (
                      <TimelineEvent ev={ev} index={index} variant="col" />
                    ))}
                  </div>
                </div>
              ))}
            </div>
            {group.crossings && group.crossings.length > 0 && (
              <div class="tl-crossings">
                {group.crossings.map((ev: any) => (
                  <TimelineEvent ev={ev} index={index} variant="cross" crossing={true} />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="tl-rail">
            <div class="tl-rail__line" aria-hidden="true" />
            {group.events.map((ev: any, ei: number) => (
              <div class={`tl-item ${ei % 2 === 0 ? 'tl-item--left' : 'tl-item--right'}`}>
                <span class={`tl-node${ev.major ? ' tl-node--major' : ''}`} aria-hidden="true" />
                <TimelineEvent ev={ev} index={index} variant="rail" />
              </div>
            ))}
          </div>
        )}
      </section>
    ))
  }
</div>

<style is:global>
  .tl-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 12px;
    color: var(--dim);
  }
  .tl-legend__text { margin-right: 12px; }

  /* 章节导航 */
  .tl-index {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 30px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .tl-index a {
    font-size: 12.5px;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 12px;
    background: var(--panel);
    transition: color 0.15s, border-color 0.15s;
  }
  .tl-index a:hover { color: var(--blood-bright); border-color: rgba(224, 72, 60, 0.45); }

  /* 时代分组 */
  .tl-group { margin-bottom: 44px; scroll-margin-top: 84px; }
  .tl-group:last-child { margin-bottom: 0; }
  .tl-group__head { margin-bottom: 20px; }
  .tl-group__title {
    font-family: var(--serif);
    font-size: 18px;
    margin: 0;
    padding-left: 12px;
    border-left: 3px solid var(--blood);
    letter-spacing: 0.03em;
  }
  .tl-group__hint { font-size: 13px; color: var(--dim); margin: 8px 0 0 15px; }

  /* ---------- 单轨：中轴交替 ---------- */
  .tl-rail { position: relative; }
  .tl-rail__line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    margin-left: -0.5px;
    background: linear-gradient(180deg, rgba(224, 72, 60, 0.55), rgba(43, 43, 53, 0.15));
  }
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 46px 1fr;
    align-items: start;
    margin-bottom: 18px;
  }
  .tl-item:last-child { margin-bottom: 0; }
  .tl-item--left .tl-card { grid-column: 1; }
  .tl-item--right .tl-card { grid-column: 3; }

  .tl-node {
    grid-column: 2;
    justify-self: center;
    width: 11px;
    height: 11px;
    margin-top: 22px;
    border-radius: 50%;
    background: var(--panel-3);
    border: 2px solid var(--blood);
    z-index: 1;
  }
  .tl-node--major {
    width: 17px;
    height: 17px;
    margin-top: 19px;
    background: var(--blood);
    border-color: var(--blood-bright);
    box-shadow: 0 0 0 5px rgba(179, 37, 31, 0.16), 0 0 16px rgba(224, 72, 60, 0.5);
  }

  /* ---------- 双轨：并行 ---------- */
  .tl-dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }
  .tl-col { position: relative; }
  .tl-col__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .tl-col__name {
    font-family: var(--serif);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--blood-bright);
    border-bottom: 1px solid rgba(224, 72, 60, 0.4);
    padding-bottom: 3px;
  }
  .tl-col[data-track='waylon'] .tl-col__name { color: #c9a227; border-bottom-color: rgba(201, 162, 39, 0.4); }
  .tl-col[data-track='waylon'] .tl-card { border-left-color: rgba(201, 162, 39, 0.5); }
  .tl-col[data-track='waylon'] .tl-card--major { border-left-color: rgba(201, 162, 39, 0.85); }

  .tl-col__rail {
    position: relative;
    padding-left: 20px;
  }
  .tl-col__rail::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: linear-gradient(180deg, rgba(224, 72, 60, 0.45), rgba(43, 43, 53, 0.15));
  }
  .tl-col[data-track='waylon'] .tl-col__rail::before {
    background: linear-gradient(180deg, rgba(201, 162, 39, 0.45), rgba(43, 43, 53, 0.15));
  }

  .tl-col__rail .tl-card { margin-bottom: 14px; }
  .tl-col__rail .tl-card:last-child { margin-bottom: 0; }
  .tl-col__rail .tl-card::after {
    content: '';
    position: absolute;
    left: -20px;
    top: 20px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--panel-3);
    border: 2px solid var(--blood);
  }
  .tl-col[data-track='waylon'] .tl-card::after { border-color: #c9a227; }
  .tl-col__rail .tl-card--major::after {
    width: 13px;
    height: 13px;
    left: -22px;
    top: 18px;
    background: var(--blood);
    border-color: var(--blood-bright);
    box-shadow: 0 0 0 4px rgba(179, 37, 31, 0.16);
  }
  .tl-col[data-track='waylon'] .tl-card--major::after {
    background: #c9a227;
    border-color: #e3c453;
    box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.16);
  }

  /* ---------- 交汇带 ---------- */
  .tl-crossings {
    margin-top: 26px;
    padding: 18px 20px;
    background: linear-gradient(90deg, rgba(179, 37, 31, 0.12), rgba(179, 37, 31, 0.02));
    border: 1px dashed rgba(224, 72, 60, 0.5);
    border-radius: var(--radius);
  }
  .tl-crossings .tl-card { margin: 0; }

  /* ---------- 事件卡片 ---------- */
  .tl-card {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 2px solid rgba(224, 72, 60, 0.35);
    border-radius: var(--radius);
    padding: 14px 18px;
    transition: border-color 0.15s, background 0.15s;
  }
  .tl-card:hover { background: var(--panel-2); border-left-color: var(--blood-bright); }
  .tl-card--major {
    border-left-color: var(--blood);
    background: linear-gradient(180deg, rgba(179, 37, 31, 0.09), var(--panel) 60%);
  }
  .tl-card--crossing {
    border: 1px solid rgba(224, 72, 60, 0.55);
    border-left: 3px solid var(--blood-bright);
    background: linear-gradient(180deg, rgba(179, 37, 31, 0.16), var(--panel) 70%);
  }

  .tl-card__head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 6px; }
  .tl-card__badge {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #fff;
    background: var(--blood);
    border-radius: 2px;
    padding: 0 7px;
  }
  .tl-card__time { font-size: 12px; color: var(--muted); letter-spacing: 0.03em; }
  .tl-card__title { font-size: 15.5px; margin: 0 0 7px; color: var(--text); font-family: var(--serif); }
  .tl-card__desc { font-size: 13.5px; color: var(--muted); margin: 0 0 8px; line-height: 1.75; }
  .tl-card__region { font-size: 12px; color: var(--dim); margin-bottom: 6px; }
  .tl-card__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }

  .chip {
    display: inline-block;
    font-size: 11px;
    padding: 1px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--panel-2);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .chip:hover { color: var(--blood-bright); border-color: rgba(224, 72, 60, 0.45); }
  .chip--work { color: var(--dim); }

  /* ---------- 窄屏：折叠为中轴左侧单列 ---------- */
  @media (max-width: 760px) {
    .tl-rail__line { left: 15px; margin-left: 0; }
    .tl-item { grid-template-columns: 30px 1fr; }
    .tl-item--left .tl-card, .tl-item--right .tl-card { grid-column: 2; }
    .tl-node { grid-column: 1; margin-top: 22px; }
    .tl-node--major { margin-top: 19px; }

    .tl-dual { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
