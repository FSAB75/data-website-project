---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '以游戏系列为单位的剧情与世界观科普百科' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="bg-layer" aria-hidden="true"></div>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <span class="brand__mark">▮</span>
          <span class="brand__text">游戏科普百科</span>
        </a>
        <nav class="nav">
          <a href="/">首页</a>
          <a href="/series/outlast/">逃生系列</a>
        </nav>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>本站为粉丝向资料汇编站，内容仅供学习、研究与归档参考；游戏设定以官方原作与出版物为准。</p>
        <p class="site-footer__dim">样板版本 · Astro 构建</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #08080b;
        --panel: #111116;
        --panel-2: #191920;
        --panel-3: #21212a;
        --line: #2b2b35;
        --text: #d9d6d0;
        --muted: #8d8d98;
        --dim: #5f5f6b;
        --blood: #b3251f;
        --blood-bright: #e0483c;
        --verified: #6fae7c;
        --inferred: #c9a227;
        --serif: Georgia, "Times New Roman", "Songti SC", "SimSun", serif;
        --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
        --radius: 4px;
      }

      * { box-sizing: border-box; }

      html, body { margin: 0; padding: 0; }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      /* 背景氛围层：暗色渐晕 + 细密纹理，纯 CSS，无图片 */
      .bg-layer {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(1100px 620px at 50% -10%, rgba(179, 37, 31, 0.14), transparent 60%),
          radial-gradient(900px 700px at 100% 100%, rgba(60, 70, 90, 0.12), transparent 65%),
          repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.014) 0 1px, transparent 1px 3px),
          var(--bg);
      }

      .shell {
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
      }

      a { color: inherit; }

      /* ---------- 页头 ---------- */
      .site-header {
        border-bottom: 1px solid var(--line);
        background: rgba(8, 8, 11, 0.82);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 30;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 62px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        letter-spacing: 0.06em;
      }
      .brand__mark { color: var(--blood-bright); }
      .brand__text { font-family: var(--serif); font-size: 18px; color: var(--text); }
      .nav { display: flex; gap: 22px; font-size: 14px; }
      .nav a {
        text-decoration: none;
        color: var(--muted);
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
        transition: color 0.15s, border-color 0.15s;
      }
      .nav a:hover { color: var(--text); border-bottom-color: var(--blood); }

      main { padding: 40px 24px 64px; }

      /* ---------- 标题 ---------- */
      h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.35; }
      h1 { font-size: 30px; margin: 0 0 8px; letter-spacing: 0.02em; }
      h2 {
        font-size: 21px;
        margin: 44px 0 16px;
        padding-left: 12px;
        border-left: 3px solid var(--blood);
      }
      h3 { font-size: 17px; margin: 26px 0 10px; color: var(--text); }

      .lead { color: var(--muted); font-size: 15px; margin: 0 0 8px; }

      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--blood-bright);
        margin: 0 0 10px;
      }

      /* ---------- 通用组件 ---------- */
      .panel {
        background: linear-gradient(180deg, var(--panel), rgba(17, 17, 22, 0.4));
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 20px 22px;
      }

      .tag {
        display: inline-block;
        font-size: 12px;
        line-height: 1.6;
        padding: 1px 8px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        background: var(--panel-2);
      }
      .tag--blood { color: var(--blood-bright); border-color: rgba(224, 72, 60, 0.45); background: rgba(179, 37, 31, 0.12); }
      .tag--verified { color: var(--verified); border-color: rgba(111, 174, 124, 0.4); }
      .tag--inferred { color: var(--inferred); border-color: rgba(201, 162, 39, 0.4); }

      .meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }

      /* ---------- 卡片网格 ---------- */
      .grid { display: grid; gap: 16px; }
      .grid--3 { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
      .grid--2 { grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); }

      .card {
        display: block;
        text-decoration: none;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 18px 20px;
        position: relative;
        transition: border-color 0.15s, transform 0.15s, background 0.15s;
      }
      .card::before {
        content: "";
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: var(--blood);
        opacity: 0;
        transition: opacity 0.15s;
      }
      .card:hover { border-color: rgba(224, 72, 60, 0.5); background: var(--panel-2); transform: translateY(-2px); }
      .card:hover::before { opacity: 1; }
      .card__index {
        font-family: var(--serif);
        font-size: 12px;
        letter-spacing: 0.16em;
        color: var(--dim);
        margin-bottom: 8px;
      }
      .card__title { font-family: var(--serif); font-size: 19px; margin: 0 0 4px; }
      .card__en { font-size: 12px; color: var(--dim); letter-spacing: 0.04em; margin-bottom: 10px; }
      .card__desc { font-size: 14px; color: var(--muted); margin: 0; }
      .card__foot { margin-top: 14px; font-size: 13px; color: var(--blood-bright); }

      /* ---------- 正文排版 ---------- */
      .prose p { margin: 0 0 14px; }
      .prose p:last-child { margin-bottom: 0; }

      /* ---------- 术语高亮联动 ---------- */
      .term {
        position: relative;
        color: var(--blood-bright);
        text-decoration: none;
        border-bottom: 1px dashed rgba(224, 72, 60, 0.5);
        cursor: help;
      }
      .term__hit { border-radius: 2px; transition: background 0.12s; }
      .term:hover .term__hit, .term:focus .term__hit { background: rgba(224, 72, 60, 0.2); }

      .term__card {
        display: none;
        position: absolute;
        left: 0;
        bottom: 150%;
        width: 302px;
        z-index: 60;
        background: var(--panel-2);
        border: 1px solid var(--line);
        border-left: 3px solid var(--blood);
        border-radius: var(--radius);
        padding: 12px 14px;
        text-align: left;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.7);
        color: var(--text);
        font-size: 13px;
        line-height: 1.65;
        cursor: default;
        pointer-events: none;
      }
      .term:hover .term__card, .term:focus .term__card, .term:focus-within .term__card {
        display: block;
      }
      .term__card-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin-bottom: 4px; }
      .term__name { font-family: var(--serif); font-size: 16px; color: var(--text); }
      .term__en { font-size: 11px; color: var(--dim); letter-spacing: 0.04em; }
      .term__type {
        display: inline-block;
        font-size: 11px;
        color: var(--blood-bright);
        border: 1px solid rgba(224, 72, 60, 0.4);
        border-radius: 999px;
        padding: 0 7px;
        margin-bottom: 7px;
      }
      .term__alias { display: block; font-size: 11px; color: var(--dim); margin-bottom: 5px; }
      .term__desc { display: block; color: var(--muted); }
      .term__more { display: block; margin-top: 8px; font-size: 12px; color: var(--blood-bright); }

      /* ---------- 页脚 ---------- */
      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: 48px;
        padding: 26px 0 40px;
        font-size: 13px;
        color: var(--dim);
      }
      .site-footer p { margin: 0 0 6px; }
      .site-footer__dim { color: #43434d; }

      @media (max-width: 640px) {
        h1 { font-size: 24px; }
        main { padding: 28px 18px 48px; }
        .term__card { width: 250px; }
      }
    </style>
  </body>
</html>
