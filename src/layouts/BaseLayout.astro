---
import { seriesList, works, entities } from '../lib/data.js';

interface Props {
  title: string;
  description?: string;
  /** 分享卡缩略图（相对路径，如 /images/works/outlast1.jpg）；不传则不输出 og:image */
  image?: string | null;
  /** og:type，文章类页面可传 article */
  type?: string;
  /** 视觉主题；不同系列可用不同基调（默认为逃生的暗黑恐怖风） */
  theme?: string;
  /** F5：结构化数据（JSON-LD），传对象则输出到 <head> */
  jsonLd?: Record<string, unknown> | null;
  /** 不需要被搜索引擎收录的页面（如 404）置为 true */
  noindex?: boolean;
}
const {
  title,
  description = '游戏档案室 —— 以「游戏系列」为单位的剧情与世界观资料汇编',
  image = null,
  type = 'website',
  theme = 'outlast',
  jsonLd = null,
  noindex = false,
} = Astro.props;

// 站内规模（页脚展示用）
const nametagCount = seriesList.reduce((n, s) => n + ((s.nametags?.nametags || []).length), 0);
const scale = [
  `${seriesList.length} 个系列`,
  `${works.length} 部作品`,
  `${entities.length} 个词条`,
  nametagCount ? `${nametagCount} 条名牌` : null,
].filter(Boolean).join(' · ');

// 页面构建日期（页脚极淡小字）
const buildDate = new Date().toISOString().slice(0, 10);

// F4：ICP 备案号与公安网备案号（工信部要求备案号须在网站底部展示并链接到 beian.miit.gov.cn）。
// 未设置环境变量时不渲染，因此备案期间不影响现有页面。
const icp = import.meta.env.PUBLIC_ICP || '';
const gongan = import.meta.env.PUBLIC_GONGAN || '';

// 浏览器地址栏配色随主题走
const THEME_COLORS: Record<string, string> = {
  'outlast': '#08080b',
  'corpse-party': '#12100d',
  'forgive-me-father': '#0b0d0b',
  'resident-evil': '#090b0c',
};
const themeColor = THEME_COLORS[theme] || '#08080b';

// canonical / og:image 需要绝对地址；site 已在 astro.config.mjs 中配置
const url = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = url(Astro.url.pathname);
const ogImage = image ? url(image) : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="游戏档案室" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="2560" />}
    {ogImage && <meta property="og:image:height" content="1440" />}
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-theme={theme}>
    <div class="bg-layer" aria-hidden="true"></div>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.5 9.6h5.1l1.5 1.7h10.4c.9 0 1.5.7 1.5 1.5v6.1c0 .9-.7 1.6-1.6 1.6H4.1c-.9 0-1.6-.7-1.6-1.6v-7.7c0-.9.7-1.6 1.6-1.6z" fill="currentColor"/>
              <path d="M5.6 5.4h3.6l1.3 1.4h6.1c.8 0 1.4.6 1.4 1.4v.9H3.9V6.8c0-.8.7-1.4 1.7-1.4z" fill="currentColor" opacity=".55"/>
            </svg>
          </span>
          <span class="brand__lockup">
            <span class="brand__text">游戏档案室</span>
            <span class="brand__en">GAME ARCHIVE</span>
          </span>
        </a>
        <nav class="nav">
          <a href="/">首页</a>
          {seriesList.map((s) => <a href={`/series/${s.id}/`}>{s.series.nameZh}系列</a>)}
          <a href="/search/">搜索</a>
        </nav>
        <!-- E2：窄屏（≤640px）改汉堡菜单；用原生 details，零 JS；宽屏整块不显示 -->
        <details class="nav-menu">
          <summary class="nav-menu__btn" aria-label="打开导航菜单">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            </svg>
            <span class="nav-menu__txt">导航</span>
          </summary>
          <nav class="nav-menu__panel">
            <a href="/">首页</a>
            {seriesList.map((s) => <a href={`/series/${s.id}/`}>{s.series.nameZh}系列</a>)}
            <a href="/search/">搜索</a>
          </nav>
        </details>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p class="site-footer__scale">目前已收录 <strong>{scale}</strong>，内容仍在持续补充。</p>
        <p>本站为粉丝向资料汇编站，内容仅供学习、研究与归档参考；游戏设定以官方原作与出版物为准。</p>
        <p>
          页面配图均来自各游戏<strong>官方商店页（Steam）的宣传素材</strong>——
          非官方授权出版物，仅作介绍与氛围示意；如相关权利人提出异议，本站将立即撤下。
        </p>
        <p>游戏名称、角色与相关设定版权归各自原权利方所有。</p>
        <p>资料整理难免有疏漏或推测成分，<strong>发现错误或想补充内容欢迎反馈</strong>（项目仓库 GitHub：FSAB75/data-website-project）。</p>
        {(icp || gongan) && (
          <p class="site-footer__beian">
            {icp && (
              <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer nofollow">{icp}</a>
            )}
            {icp && gongan && ' · '}
            {gongan && (
              <a href="https://beian.mps.gov.cn/" target="_blank" rel="noopener noreferrer nofollow">{gongan}</a>
            )}
          </p>
        )}
        <p class="site-footer__dim">由玩家自发整理维护 · 最后构建 {buildDate}</p>
      </div>
    </footer>

    <!-- C2：回到顶部（原生锚点 #top，零 JS） -->
    <a class="to-top" href="#top" aria-label="回到顶部">回到顶部 ↑</a>

    <script>
      // C3：词条悬停卡片原本一律向上弹出，词条靠近视口顶部时会被裁切。
      // 这里在悬停 / 聚焦时量一下位置，靠得太近就改成向下弹出。
      const FAR_ENOUGH = 210;
      function placeCard(ev) {
        const target = ev.target;
        if (!target || !target.closest) return;
        const term = target.closest('.term');
        if (!term) return;
        const card = term.querySelector('.term__card');
        if (!card) return;
        term.classList.toggle('term--below', term.getBoundingClientRect().top < FAR_ENOUGH);
      }
      document.addEventListener('mouseover', placeCard);
      document.addEventListener('focusin', placeCard);

      // E4：触屏没有 hover，手指点高亮词会直接跳走，那张速览卡片永远看不到。
      // 这里在「无真实悬停」的设备上改成：第一次点先弹卡片，再点一下才跳转；
      // 点空白处 / 滚动 / 按 Esc 收起。桌面（有 hover）完全不进这段逻辑。
      const noHover = window.matchMedia('(hover: none)').matches;

      function closeTerms() {
        for (const t of document.querySelectorAll('.term--open')) t.classList.remove('term--open');
      }

      function openTerm(term) {
        closeTerms();
        term.classList.add('term--open');
        const card = term.querySelector('.term__card');
        if (!card) return;
        // 横向位置不写 left，而是「先量它在哪儿、再平移多少」：
        // 词条是 inline，跨行时绝对定位的包含块原点会偏离词条本身（实测能差 100px 以上），
        // 直接算 left 会偏；先量实际渲染位置再平移，对这种情况免疫。
        card.style.left = '';
        card.style.transform = '';
        const cw = card.offsetWidth || 302;
        const r = term.getBoundingClientRect();
        const maxLeft = Math.max(8, window.innerWidth - cw - 8);
        const want = Math.min(Math.max(r.left + r.width / 2 - cw / 2, 8), maxLeft);
        const shift = want - card.getBoundingClientRect().left;
        if (shift) card.style.transform = `translateX(${shift.toFixed(1)}px)`;
        // 纵向：默认向上弹（样式里 bottom:150%）；词条离视口顶部太近就改成向下弹
        // （这里自己算一遍，不依赖兼容鼠标事件触发的 C3 逻辑）
        term.classList.toggle('term--below', r.top < (card.offsetHeight || 0) + 16);
      }

      if (noHover) {
        document.addEventListener('click', (ev) => {
          const target = ev.target;
          const term = target && target.closest ? target.closest('.term') : null;
          if (!term) { closeTerms(); return; }
          if (term.classList.contains('term--open')) return; // 已展开：放行走默认跳转
          ev.preventDefault();
          openTerm(term);
        });
        document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeTerms(); });
      }
    </script>

    <style is:global>
      :root {
        --bg: #08080b;
        --panel: #111116;
        --panel-2: #191920;
        --panel-3: #21212a;
        --line: #2b2b35;
        --text: #d9d6d0;
        --muted: #8d8d98;
        --dim: #7f7f8c; /* C4：实测对比度约 5.1:1（原 #5f5f6b 仅 3.2:1，低于 4.5:1 无障碍线） */
        --blood: #b3251f;
        --blood-bright: #e0483c;
        --verified: #6fae7c;
        --inferred: #c9a227;
        --serif: Georgia, "Times New Roman", "Songti SC", "SimSun", serif;
        --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
        --radius: 4px;

        /* 派生色：供页面内 rgba() 使用，随主题切换 */
        --accent-rgb: 224, 72, 60;
        --accent-deep-rgb: 179, 37, 31;
        --overlay-rgb: 8, 8, 11;
      }

      /* ---------- 主题：逃生 · 暗黑科技恐怖风 ---------- */

      /* ---------- 主题：尸体派对 · 和风校园怪谈（褪色木色 / 暗红 / 宣纸质感） ---------- */
      [data-theme='corpse-party'] {
        --bg: #12100d;
        --panel: #1b1714;
        --panel-2: #231d18;
        --panel-3: #2c241d;
        --line: #3a3026;
        --text: #ded4c4;
        --muted: #a2947f;
        --dim: #8b8172; /* C4：对比度约 5.0:1（原 #6d6353 仅 3.3:1） */
        --blood: #8c2f2a;
        --blood-bright: #c9503f;
        --serif: "Yu Mincho", "Hiragino Mincho ProN", "Noto Serif JP", "Songti SC", "SimSun", serif;

        --accent-rgb: 201, 80, 63;
        --accent-deep-rgb: 140, 47, 42;
        --overlay-rgb: 18, 16, 13;
      }
      [data-theme='corpse-party'] .bg-layer {
        background:
          radial-gradient(1100px 620px at 50% -10%, rgba(var(--accent-deep-rgb), 0.22), transparent 62%),
          radial-gradient(900px 700px at 100% 100%, rgba(120, 160, 160, 0.06), transparent 65%),
          repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.016) 0 1px, transparent 1px 5px),
          repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 6px),
          var(--bg);
      }
      [data-theme='corpse-party'] .site-header { background: rgba(18, 16, 13, 0.85); }
      [data-theme='corpse-party'] .term { cursor: help; }

      /* ---------- 主题：宽恕我神父 · 手绘漫画恐怖（墨黑 / 硫黄 / 半调网点质感） ---------- */
      [data-theme='forgive-me-father'] {
        --bg: #0b0d0b;
        --panel: #141713;
        --panel-2: #1d211b;
        --panel-3: #262b23;
        --line: #333a2f;
        --text: #d9d5c7;
        --muted: #94927e;
        --dim: #82836f; /* 与 C4 同口径：对 --bg 的对比度约 5.4:1 */
        --blood: #8a7a1f;
        --blood-bright: #cbb43c;

        --accent-rgb: 203, 180, 60;
        --accent-deep-rgb: 138, 122, 31;
        --overlay-rgb: 11, 13, 11;
      }
      [data-theme='forgive-me-father'] .bg-layer {
        background:
          radial-gradient(1100px 620px at 50% -10%, rgba(var(--accent-deep-rgb), 0.2), transparent 62%),
          radial-gradient(900px 700px at 100% 100%, rgba(70, 90, 70, 0.08), transparent 65%),
          repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.06) 0 2px, transparent 2px 4px),
          var(--bg);
      }
      [data-theme='forgive-me-father'] .site-header { background: rgba(11, 13, 11, 0.85); }

      /* ---------- 主题：生化危机 · 冷调实验室（冷蓝灰 + 血红强调，网格化纹理） ---------- */
      [data-theme='resident-evil'] {
        --bg: #090b0c;
        --panel: #111517;
        --panel-2: #1a2023;
        --panel-3: #232b2f;
        --line: #2f3a3f;
        --text: #d6d8d6;
        --muted: #8f9a99;
        --dim: #7f8b8a; /* 对 --bg 的对比度约 5.7:1 */
        --blood: #8f2b24;
        --blood-bright: #d9534a;

        --accent-rgb: 217, 83, 74;
        --accent-deep-rgb: 143, 43, 36;
        --overlay-rgb: 9, 11, 12;
      }
      [data-theme='resident-evil'] .bg-layer {
        background:
          radial-gradient(1100px 620px at 50% -10%, rgba(var(--accent-deep-rgb), 0.18), transparent 60%),
          radial-gradient(900px 700px at 100% 100%, rgba(40, 90, 95, 0.12), transparent 65%),
          repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.012) 0 1px, transparent 1px 4px),
          repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.12) 0 1px, transparent 1px 4px),
          var(--bg);
      }
      [data-theme='resident-evil'] .site-header { background: rgba(9, 11, 12, 0.85); }

      * { box-sizing: border-box; }

      html, body { margin: 0; padding: 0; }

      /* 锚点跳转平滑滚动（区块导航 / 回到顶部 / 名牌深链）；尊重系统的「减少动态效果」设置 */
      @media (prefers-reduced-motion: no-preference) {
        html { scroll-behavior: smooth; }
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      /* 背景氛围层：暗色渐晕 + 细密纹理，纯 CSS，无图片 */
      .bg-layer {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(1100px 620px at 50% -10%, rgba(var(--accent-deep-rgb), 0.14), transparent 60%),
          radial-gradient(900px 700px at 100% 100%, rgba(60, 70, 90, 0.12), transparent 65%),
          repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.014) 0 1px, transparent 1px 3px),
          var(--bg);
      }

      .shell {
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
      }

      a { color: inherit; }

      /* ---------- 页头 ---------- */
      .site-header {
        border-bottom: 1px solid var(--line);
        background: rgba(var(--overlay-rgb), 0.82);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 30;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 62px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }
      .brand__mark {
        display: inline-flex;
        width: 24px;
        height: 24px;
        color: var(--blood-bright);
        transition: color 0.15s;
      }
      .brand__mark svg { width: 100%; height: 100%; }
      .brand__lockup { display: flex; flex-direction: column; }
      .brand__text {
        font-family: var(--serif);
        font-size: 18px;
        line-height: 1.2;
        color: var(--text);
        letter-spacing: 0.1em;
      }
      .brand__en {
        font-size: 9px;
        line-height: 1.2;
        letter-spacing: 0.26em;
        color: var(--dim);
        transition: color 0.15s;
        white-space: nowrap;
      }
      .brand:hover .brand__mark,
      .brand:hover .brand__en { color: var(--blood-bright); }
      .nav { display: flex; gap: 22px; font-size: 14px; }
      .nav a {
        text-decoration: none;
        color: var(--muted);
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
        transition: color 0.15s, border-color 0.15s;
      }
      .nav a:hover { color: var(--text); border-bottom-color: var(--blood); }

      /* E2：汉堡菜单 —— 宽屏整块隐藏，≤640px 才出现（原生 details，无 JS） */
      .nav-menu { display: none; position: relative; }
      .nav-menu__btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        list-style: none;
        cursor: pointer;
        font-size: 13px;
        color: var(--muted);
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 6px 11px;
        min-height: 38px;
        transition: color 0.15s, border-color 0.15s;
      }
      .nav-menu__btn::-webkit-details-marker { display: none; }
      .nav-menu__btn svg { width: 18px; height: 18px; }
      .nav-menu__btn:focus-visible { outline: 2px solid rgba(var(--accent-rgb), 0.7); outline-offset: 2px; }
      .nav-menu[open] .nav-menu__btn { color: var(--text); border-color: rgba(var(--accent-rgb), 0.5); }
      .nav-menu__panel {
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        z-index: 50;
        min-width: 184px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 6px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.65);
      }
      .nav-menu__panel a {
        display: block;
        padding: 11px 12px;
        font-size: 14.5px;
        text-decoration: none;
        color: var(--muted);
        border-radius: var(--radius);
        transition: color 0.15s, background 0.15s;
      }
      .nav-menu__panel a:hover { color: var(--text); background: var(--panel-2); }

      main { padding: 40px 24px 64px; }

      /* ---------- 标题 ---------- */
      h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.35; }
      h1 { font-size: 30px; margin: 0 0 8px; letter-spacing: 0.02em; }
      h2 {
        font-size: 21px;
        margin: 44px 0 16px;
        padding-left: 12px;
        border-left: 3px solid var(--blood);
      }
      h3 { font-size: 17px; margin: 26px 0 10px; color: var(--text); }

      .lead { color: var(--muted); font-size: 15px; margin: 0 0 8px; }

      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--blood-bright);
        margin: 0 0 10px;
      }

      /* ---------- 通用组件 ---------- */
      .panel {
        background: linear-gradient(180deg, var(--panel), rgba(var(--overlay-rgb), 0.4));
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 20px 22px;
      }

      .tag {
        display: inline-block;
        font-size: 12px;
        line-height: 1.6;
        padding: 1px 8px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        background: var(--panel-2);
      }

      /* ---------- 页面内插图（D1）：图片 + 说明 + 来源 ---------- */
      .scene-list {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
        margin: 22px 0 6px;
      }
      .scene {
        margin: 0;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--panel-3);
      }
      .scene img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
      }
      .scene__cap {
        display: block;
        padding: 10px 14px;
        font-size: 12.5px;
        line-height: 1.6;
        color: var(--muted);
        background: var(--panel);
      }
      .scene__src { display: block; margin-top: 2px; font-size: 11.5px; color: var(--dim); }
      .scene__src a { color: var(--dim); }
      .tag--blood { color: var(--blood-bright); border-color: rgba(var(--accent-rgb), 0.45); background: rgba(var(--accent-deep-rgb), 0.12); }
      .tag--read { color: var(--text); border-color: rgba(var(--accent-rgb), 0.55); background: rgba(var(--accent-deep-rgb), 0.18); }
      .tag--verified { color: var(--verified); border-color: rgba(111, 174, 124, 0.4); }
      .tag--inferred { color: var(--inferred); border-color: rgba(201, 162, 39, 0.4); }

      .meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }

      /* ---------- 卡片网格 ---------- */
      /* E1：min(100%, Xpx) 保证轨道永远塞得进容器 —— 窄屏自动塌成单列，不再撑出横向滚动 */
      .grid { display: grid; gap: 16px; }
      .grid--3 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
      .grid--2 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }

      .card {
        display: block;
        text-decoration: none;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 18px 20px;
        position: relative;
        transition: border-color 0.15s, transform 0.15s, background 0.15s;
      }
      .card::before {
        content: "";
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: var(--blood);
        opacity: 0;
        transition: opacity 0.15s;
      }
      .card:hover { border-color: rgba(var(--accent-rgb), 0.5); background: var(--panel-2); }
      .card:hover::before { opacity: 1; }
      /* E7：上浮只在「真有指针、能真正悬停」的设备上做，触屏点完不会浮起来卡住 */
      @media (hover: hover) {
        .card:hover { transform: translateY(-2px); }
      }
      .card__index {
        font-family: var(--serif);
        font-size: 12px;
        letter-spacing: 0.16em;
        color: var(--dim);
        margin-bottom: 8px;
      }
      .card__title { font-family: var(--serif); font-size: 19px; margin: 0 0 4px; }
      .card__en { font-size: 12px; color: var(--dim); letter-spacing: 0.04em; margin-bottom: 10px; }
      .card__desc { font-size: 14px; color: var(--muted); margin: 0; }
      .card__foot { margin-top: 14px; font-size: 13px; color: var(--blood-bright); }

      /* ---------- 正文排版 ---------- */
      .prose p { margin: 0 0 14px; }
      .prose p:last-child { margin-bottom: 0; }

      /* ---------- 术语高亮联动 ---------- */
      .term {
        position: relative;
        color: var(--blood-bright);
        text-decoration: none;
        border-bottom: 1px dashed rgba(var(--accent-rgb), 0.5);
        cursor: help;
      }
      .term__hit { border-radius: 2px; transition: background 0.12s; }
      .term:hover .term__hit, .term:focus .term__hit { background: rgba(var(--accent-rgb), 0.2); }

      .term__card {
        display: none;
        position: absolute;
        left: 0;
        bottom: 150%;
        width: 302px;
        z-index: 60;
        background: var(--panel-2);
        border: 1px solid var(--line);
        border-left: 3px solid var(--blood);
        border-radius: var(--radius);
        padding: 12px 14px;
        text-align: left;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.7);
        color: var(--text);
        font-size: 13px;
        line-height: 1.65;
        cursor: default;
        pointer-events: none;
      }
      .term:hover .term__card, .term:focus .term__card, .term:focus-within .term__card {
        display: block;
      }
      /* C3：词条靠近视口顶部时改为向下弹出，避免卡片被裁切 */
      .term--below .term__card { bottom: auto; top: calc(100% + 2px); }
      .term__card-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin-bottom: 4px; }
      .term__name { font-family: var(--serif); font-size: 16px; color: var(--text); }
      .term__en { font-size: 11px; color: var(--dim); letter-spacing: 0.04em; }
      .term__type {
        display: inline-block;
        font-size: 11px;
        color: var(--blood-bright);
        border: 1px solid rgba(var(--accent-rgb), 0.4);
        border-radius: 999px;
        padding: 0 7px;
        margin-bottom: 7px;
      }
      .term__alias { display: block; font-size: 11px; color: var(--dim); margin-bottom: 5px; }
      .term__desc { display: block; color: var(--muted); }
      .term__more { display: block; margin-top: 8px; font-size: 12px; color: var(--blood-bright); }

      /* ---------- 页脚 ---------- */
      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: 48px;
        padding: 26px 0 40px;
        font-size: 13px;
        color: var(--dim);
      }
      .site-footer p { margin: 0 0 6px; }
      .site-footer__scale { color: var(--muted); }
      .site-footer__scale strong { color: var(--text); font-weight: 600; }
      .site-footer__dim { color: var(--dim); } /* C4：原来写死 #43434d，对比度不足 */
      .site-footer__beian { margin-top: 10px; }
      .site-footer__beian a { color: var(--dim); text-decoration: none; border-bottom: 1px solid var(--line); }
      .site-footer__beian a:hover { color: var(--text); }

      /* C2：回到顶部（原生锚点，零 JS） */
      .to-top {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 40;
        font-size: 12.5px;
        text-decoration: none;
        color: var(--muted);
        background: rgba(var(--overlay-rgb), 0.9);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 7px 15px;
        backdrop-filter: blur(6px);
        transition: color 0.15s, border-color 0.15s;
      }
      .to-top:hover { color: var(--blood-bright); border-color: rgba(var(--accent-rgb), 0.5); }

      /* C9：触屏设备上把顶栏导航与「回到顶部」的可点区域放大 */
      @media (pointer: coarse) {
        .nav { gap: 16px; }
        .nav a { padding: 16px 4px; }
        .to-top { padding: 12px 20px; font-size: 13.5px; }
      }

      /* E2：窄屏隐藏横排导航，改用汉堡菜单 */
      @media (max-width: 640px) {
        .nav { display: none; }
        .nav-menu { display: block; }
      }

      /* E4：触屏（没有真实悬停）上，词条卡片改为「点一下先弹出来」
         —— 位置仍相对词条（绝对定位），由脚本把横向夹在视口内，避免右侧撑出横向滚动。
         注意：这里不能用 position: fixed —— 页面里存在带 transform/filter 的祖先容器，
         它们会成为 fixed 的包含块，卡片会被「劫持」到别处去。 */
      @media (hover: none) {
        .term--open .term__card {
          display: block;
          width: min(302px, calc(100vw - 24px));
          pointer-events: auto;
          z-index: 80;
        }
        .term--open .term__hit { background: rgba(var(--accent-rgb), 0.24); }
      }

      @media (max-width: 640px) {
        h1 { font-size: 24px; }
        main { padding: 28px 18px 48px; }
        .term__card { width: 250px; }
      }
    </style>
  </body>
</html>
